#import, file "./range.zi";
using Codec :: #import "image_codec/api"

// Scalar lossless TX_4X4 coefficient syntax, AV1 5.11.39 / 8.3.
// CDF state is tile-owned; coefficient positions are specification row-major.
// Probability constants and scan order are from pinned libaom (see cdfs4.zi).
#import, file "./cdfs4.zi";

CoeffBlock4x4 :: struct {
    quant: [16]s32;
    eob: s32;
    level: s32;
    dc_category: s32;
    error: DecodeError;
}

// Caller selects luma or UV probability state and corresponding all_zero/
// dc_sign contexts from above/left blocks. UV skip slots0..5 map contexts7..12.
// This function has fixed storage and a bounded number of entropy operations.
ReadLosslessCoefficients4x4 :: (decoder: *RangeDecoder, cdfs: *CoeffCDF4x4,
    skip_context: s32, dc_context: s32, cancellation: *Cancellation = null) -> CoeffBlock4x4 {
    result: CoeffBlock4x4
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    if decoder == null || cdfs == null || skip_context < 0 || skip_context > 6 || dc_context < 0 || dc_context > 2 {
        result.error = Error(InvalidInput); return result
    }
    empty := ReadSymbol(decoder, cdfs.skip[skip_context * 3:skip_context * 3 + 3])
    if decoder.error.code != DecodeOK { result.error = decoder.error; return result }
    if empty == 1 { return result }
    point := ReadSymbol(decoder, cdfs.eob[:]) + 1
    eob := ifx point < 2 then point else cast(s32)(cast(u32)1 << cast(u32)(point - 2)) + 1
    if point >= 3 {
        extra := ReadSymbol(decoder, cdfs.extra[(point - 3) * 3:(point - 3) * 3 + 3])
        eob += cast(s32)(cast(u32)extra << cast(u32)(point - 3))
        remaining := point - 4
        while remaining >= 0 {
            eob += cast(s32)(ReadBool(decoder) << cast(u32)remaining)
            remaining -= 1
        }
    }
    if decoder.error.code != DecodeOK { result.error = decoder.error; return result }
    if eob < 1 || eob > 16 { result.error = Error(MalformedInput, decoder.bits.byte); return result }
    result.eob = eob
    // Transpose of libaom's column-major default_scan_4x4; these are the
    // specification's row-major coefficient positions.
    scan: [16]s32 = .[0,1,4,8,5,2,3,6,9,12,13,10,7,11,14,15]
    offsets: [16]s32 = .[0,1,6,6,1,6,6,21,6,6,21,21,6,21,21,21]
    index := eob - 1
    while index >= 0 {
        result.error = CancellationError(cancellation)
        if result.error.code != DecodeOK { return result }
        position := scan[index]; row := position / 4; column := position % 4
        level: s32
        if index == eob - 1 {
            context: s32 = ifx index == 0 then 0 else (ifx index <= 2 then 1 else (ifx index <= 4 then 2 else 3))
            level = ReadSymbol(decoder, cdfs.base_eob[context * 4:context * 4 + 4]) + 1
        } else {
            magnitude: s32
            for neighbor: 0..4 {
                dr: [5]s32 = .[0,1,1,0,2]
                dc: [5]s32 = .[1,0,1,2,0]
                r := row + dr[neighbor]; c := column + dc[neighbor]
                if r < 4 && c < 4 {
                    value := result.quant[r * 4 + c]
                    magnitude += ifx value < 3 then value else 3
                }
            }
            context := (magnitude + 1) >> 1
            if context > 4 { context = 4 }
            context += offsets[position]
            if position == 0 { context = 0 }
            level = ReadSymbol(decoder, cdfs.base[context * 5:context * 5 + 5])
        }
        if level > 2 {
            magnitude: s32
            for neighbor: 0..2 {
                dr: [3]s32 = .[0,1,1]; dc: [3]s32 = .[1,0,1]
                r := row + dr[neighbor]; c := column + dc[neighbor]
                if r < 4 && c < 4 {
                    value := result.quant[r * 4 + c]
                    magnitude += ifx value < 15 then value else 15
                }
            }
            context := (magnitude + 1) >> 1
            if context > 6 { context = 6 }
            if position != 0 { context += ifx row < 2 && column < 2 then 7 else 14 }
            for extension: 0..3 {
                more := ReadSymbol(decoder, cdfs.br[context * 5:context * 5 + 5])
                level += more
                if more < 3 { break }
            }
        }
        if decoder.error.code != DecodeOK { result.error = decoder.error; return result }
        result.quant[position] = level
        index -= 1
    }
    for i: 0..eob - 1 {
        position := scan[i]; level := result.quant[position]
        sign: s32
        if level != 0 {
            if i == 0 { sign = ReadSymbol(decoder, cdfs.dc[dc_context * 3:dc_context * 3 + 3]) }
            else { sign = cast(s32)ReadBool(decoder) }
        }
        if level > 14 {
            // Spec golomb_length_bit must terminate by the twentieth bit.
            // Widen before shifts/adds, then apply the normative 20-bit mask.
            length: s32
            while ReadBool(decoder) == 0 && decoder.error.code == DecodeOK {
                length += 1
                if length >= 20 { result.error = Error(MalformedInput, decoder.bits.byte); return result }
            }
            extra := cast(u32)1 << cast(u32)length
            extra |= ReadLiteral(decoder, length)
            level = cast(s32)(extra + 14)
        }
        if decoder.error.code != DecodeOK { result.error = decoder.error; return result }
        if position == 0 && level != 0 { result.dc_category = ifx sign == 1 then 1 else 2 }
        level &= 1048575
        result.level += level
        result.quant[position] = ifx sign == 1 then -level else level
    }
    if result.level > 63 { result.level = 63 }
    result.error = CancellationError(cancellation)
    return result
}
