using Codec :: #import "image_codec/api"

Prediction4x4 :: struct { samples: [16]u16; error: DecodeError; }

// AV1 7.11.2 scalar intra reference for lossless 4x4 transforms. Above/left
// contain four already extended samples and corner is AboveRow[-1]. Have flags
// select DC averaging; edge construction belongs to the frame/tile caller.
// V/H here are exact 90/180 degrees (angle_delta=0), without edge filtering.
PredictIntra4x4 :: (above: []u16, left: []u16, corner: u16,
    have_above: bool, have_left: bool, mode: s32, bit_depth: s32,
    cancellation: *Cancellation = null) -> Prediction4x4 {
    result: Prediction4x4
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    if above.count != 4 || left.count != 4 || (bit_depth != 8 && bit_depth != 10 && bit_depth != 12) {
        result.error = Error(InvalidInput); return result
    }
    if mode != 0 && mode != 1 && mode != 2 && mode != 9 && mode != 10 && mode != 11 && mode != 12 {
        result.error = Error(UnsupportedCapability); return result
    }
    midpoint := cast(s32)(cast(u32)1 << cast(u32)(bit_depth - 1))
    maximum := midpoint * 2 - 1
    if corner > maximum { result.error = Error(InvalidInput); return result }
    sum: s32; count: s32
    for i: 0..3 {
        if above[i] > maximum || left[i] > maximum { result.error = Error(InvalidInput); return result }
        if have_above { sum += cast(s32)above[i] }
        if have_left { sum += cast(s32)left[i] }
    }
    if have_above { count += 4 }
    if have_left { count += 4 }
    dc := ifx count == 0 then midpoint else (sum + count / 2) / count
    weights: [4]s32 = .[255,149,85,64]
    for row: 0..3 {
        for column: 0..3 {
            a := cast(s32)above[column]; l := cast(s32)left[row]
            value := dc
            if mode == 1 { value = a }
            else if mode == 2 { value = l }
            else if mode == 9 {
                vertical := weights[row] * a + (256 - weights[row]) * cast(s32)left[3]
                horizontal := weights[column] * l + (256 - weights[column]) * cast(s32)above[3]
                value = (vertical + horizontal + 256) >> 9
            } else if mode == 10 { value = (weights[row] * a + (256 - weights[row]) * cast(s32)left[3] + 128) >> 8 }
            else if mode == 11 { value = (weights[column] * l + (256 - weights[column]) * cast(s32)above[3] + 128) >> 8 }
            else if mode == 12 {
                base := a + l - cast(s32)corner
                pl := base - l; pt := base - a; pc := base - cast(s32)corner
                if pl < 0 { pl = -pl }; if pt < 0 { pt = -pt }; if pc < 0 { pc = -pc }
                if pl <= pt && pl <= pc { value = l }
                else if pt <= pc { value = a }
                else { value = cast(s32)corner }
            }
            result.samples[row * 4 + column] = cast(u16)value
        }
    }
    return result
}
