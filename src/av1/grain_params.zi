#import, file "./bits.zi";
using Codec :: #import "image_codec/api"

// AV1 film_grain_params / 6.8.20 for displayed non-inter frames.
// No reference inheritance: callers parsing inter frames must use their actual
// reference state instead. This module does not synthesize grain or pixels.
FilmGrainParams :: struct {
    apply_grain: bool; random_seed: u32;
    num_y_points: s32; scaling_points_y: [28]s32;
    num_cb_points: s32; scaling_points_cb: [20]s32;
    num_cr_points: s32; scaling_points_cr: [20]s32;
    chroma_scaling_from_luma: bool;
    scaling_shift: s32; ar_coeff_lag: s32;
    ar_coeffs_y: [24]s32; ar_coeffs_cb: [25]s32; ar_coeffs_cr: [25]s32;
    ar_coeff_shift: s32; grain_scale_shift: s32;
    cb_mult: s32; cb_luma_mult: s32; cb_offset: s32;
    cr_mult: s32; cr_luma_mult: s32; cr_offset: s32;
    overlap_flag: bool; clip_to_restricted_range: bool;
}
FilmGrainResult :: struct { parameters: FilmGrainParams; error: DecodeError; }

#scope_file
GrainPoints :: (bits: *BitReader, points: []s32, maximum: s32,
    cancellation: *Cancellation) -> s32 {
    at := bits.byte
    count := cast(s32)ReadBits(bits, 4)
    if bits.error.code != DecodeOK { return 0 }
    if count > maximum { bits.error = Error(MalformedInput, at); return 0 }
    for i: 0..count - 1 {
        bits.error = CancellationError(cancellation)
        if bits.error.code != DecodeOK { return 0 }
        at = bits.byte
        value := cast(s32)ReadBits(bits, 8)
        if bits.error.code != DecodeOK { return 0 }
        if i > 0 && value <= points[(i - 1) * 2] { bits.error = Error(MalformedInput, at); return 0 }
        points[i * 2] = value; points[i * 2 + 1] = cast(s32)ReadBits(bits, 8)
        if bits.error.code != DecodeOK { return 0 }
    }
    return count
}
GrainCoefficients :: (bits: *BitReader, coefficients: []s32, count: s32,
    cancellation: *Cancellation) {
    for i: 0..count - 1 {
        if bits.error.code != DecodeOK { return }
        bits.error = CancellationError(cancellation)
        if bits.error.code != DecodeOK { return }
        coefficients[i] = cast(s32)ReadBits(bits, 8) - 128
    }
}

#scope_export
// Reads from the exact current MSB syntax bit position. Successful absence
// resets all parameters; malformed/truncated/cancelled results commit none.
ReadStillFilmGrain :: (bits: *BitReader, present: bool, monochrome: bool,
    subsampling_x: s32, subsampling_y: s32,
    cancellation: *Cancellation = null) -> FilmGrainResult {
    result: FilmGrainResult
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    if bits == null || subsampling_x < 0 || subsampling_x > 1 || subsampling_y < 0 || subsampling_y > 1 {
        result.error = Error(InvalidInput); return result
    }
    unused ReadBits(bits, 0)
    if bits.error.code != DecodeOK { result.error = bits.error; return result }
    if !present { return result }
    params: FilmGrainParams
    params.apply_grain = ReadBits(bits, 1) != 0
    if bits.error.code != DecodeOK { result.error = bits.error; return result }
    if !params.apply_grain { return result }
    params.random_seed = ReadBits(bits, 16)
    if bits.error.code == DecodeOK { params.num_y_points = GrainPoints(bits, params.scaling_points_y[:], 14, cancellation) }
    if !monochrome { params.chroma_scaling_from_luma = ReadBits(bits, 1) != 0 }
    if !monochrome && !params.chroma_scaling_from_luma &&
        !(subsampling_x == 1 && subsampling_y == 1 && params.num_y_points == 0) && bits.error.code == DecodeOK {
        params.num_cb_points = GrainPoints(bits, params.scaling_points_cb[:], 10, cancellation)
        if bits.error.code == DecodeOK { params.num_cr_points = GrainPoints(bits, params.scaling_points_cr[:], 10, cancellation) }
        if bits.error.code == DecodeOK && subsampling_x == 1 && subsampling_y == 1 &&
            ((params.num_cb_points == 0) != (params.num_cr_points == 0)) { bits.error = Error(MalformedInput, bits.byte) }
    }
    params.scaling_shift = cast(s32)ReadBits(bits, 2) + 8
    params.ar_coeff_lag = cast(s32)ReadBits(bits, 2)
    luma_count := 2 * params.ar_coeff_lag * (params.ar_coeff_lag + 1)
    chroma_count := luma_count
    if params.num_y_points > 0 { chroma_count += 1; GrainCoefficients(bits, params.ar_coeffs_y[:], luma_count, cancellation) }
    if params.chroma_scaling_from_luma || params.num_cb_points > 0 { GrainCoefficients(bits, params.ar_coeffs_cb[:], chroma_count, cancellation) }
    if params.chroma_scaling_from_luma || params.num_cr_points > 0 { GrainCoefficients(bits, params.ar_coeffs_cr[:], chroma_count, cancellation) }
    params.ar_coeff_shift = cast(s32)ReadBits(bits, 2) + 6
    params.grain_scale_shift = cast(s32)ReadBits(bits, 2)
    if params.num_cb_points > 0 {
        params.cb_mult = cast(s32)ReadBits(bits, 8); params.cb_luma_mult = cast(s32)ReadBits(bits, 8); params.cb_offset = cast(s32)ReadBits(bits, 9)
    }
    if params.num_cr_points > 0 {
        params.cr_mult = cast(s32)ReadBits(bits, 8); params.cr_luma_mult = cast(s32)ReadBits(bits, 8); params.cr_offset = cast(s32)ReadBits(bits, 9)
    }
    params.overlap_flag = ReadBits(bits, 1) != 0
    params.clip_to_restricted_range = ReadBits(bits, 1) != 0
    result.error = bits.error
    if result.error.code != DecodeOK { return result }
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    result.parameters = params
    return result
}
