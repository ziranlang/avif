#import, file "./prediction.zi";
using Codec :: #import "image_codec/api"

// AV1 7.11.2.4 and 7.11.2.8--12, fixed lossless4x4 scalar reference.
// Derivative constants from libaom d772e334cc724105040382a977ebb10dfd393293
// av1/common/reconintra.h. Copyright (c) 2016, 2017 Alliance for Open Media.
// BSD 2-Clause + AOM Patent License retained in this directory.
DirectionalEdge :: struct { values: [18]s32; } // logical indices -2..15, offset2
DirectionalDerivative :: (angle: s32) -> s32 {
    angles: [27]s32 = .[3,6,9,14,17,20,23,26,29,32,36,39,42,45,48,51,54,58,61,64,67,70,73,76,81,84,87]
    slopes: [27]s32 = .[1023,547,372,273,215,178,151,132,116,102,90,80,71,64,57,51,45,40,35,31,27,23,19,15,11,7,3]
    for i: 0..26 { if angle == angles[i] { return slopes[i] } }
    return 0
}
DirectionalFloor :: (value: s32, divisor: s32) -> s32 {
    if value < 0 { return -((-value + divisor - 1) / divisor) }
    return value / divisor
}
DirectionalStrength4x4 :: (delta: s32, filter_type: s32) -> s32 {
    distance := ifx delta < 0 then -delta else delta
    if filter_type == 0 { return ifx distance >= 56 then 1 else 0 }
    if distance >= 64 { return 2 }
    return ifx distance >= 40 then 1 else 0
}
DirectionalFilterEdge :: (edge: *DirectionalEdge, count: s32, strength: s32) {
    if strength == 0 { return }
    // count is5 or9, strength1 or2, from the checked4x4 caller.
    original := edge.values
    kernels: [10]s32 = .[0,4,8,4,0,0,5,6,5,0]
    for i: 1..count - 1 {
        sum: s32
        for j: 0..4 {
            at := cast(s32)i - 2 + cast(s32)j
            if at < 0 { at = 0 }; if at >= count { at = count - 1 }
            sum += kernels[(strength - 1) * 5 + j] * original[at + 1]
        }
        edge.values[i + 1] = (sum + 8) / 16
    }
}
DirectionalUpsampleEdge :: (edge: *DirectionalEdge, count: s32, maximum: s32) {
    duplicate: [11]s32
    duplicate[0] = edge.values[1]; duplicate[1] = edge.values[1]
    for i: 0..count - 1 { duplicate[i + 2] = edge.values[i + 2] }
    duplicate[count + 2] = edge.values[count + 1]
    edge.values[0] = duplicate[0]
    for i: 0..count - 1 {
        sum := -duplicate[i] + 9 * duplicate[i + 1] + 9 * duplicate[i + 2] - duplicate[i + 3]
        value := ifx sum <= 0 then 0 else (sum + 8) / 16
        if value > maximum { value = maximum }
        edge.values[2 * i + 1] = value; edge.values[2 * i + 2] = duplicate[i + 2]
    }
}

// Edges contain8 already extended source-domain samples; have flags select
// edge filtering. Filter type is derived from the coding block's neighbors.
// The returned samples are committed only on success.
PredictDirectional4x4 :: (above: []u16, left: []u16, corner: u16,
    have_above: bool, have_left: bool, mode: s32, angle_delta: s32,
    enable_edge_filter: bool, filter_type: s32, bit_depth: s32,
    cancellation: *Cancellation = null) -> Prediction4x4 {
    result: Prediction4x4
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    if above.count != 8 || left.count != 8 || mode < 1 || mode > 8 || angle_delta < -3 || angle_delta > 3 ||
        filter_type < 0 || filter_type > 1 || (bit_depth != 8 && bit_depth != 10 && bit_depth != 12) {
        result.error = Error(InvalidInput); return result
    }
    maximum := cast(s32)((cast(u32)1 << cast(u32)bit_depth) - 1)
    if corner > maximum { result.error = Error(InvalidInput); return result }
    top: DirectionalEdge; side: DirectionalEdge
    top.values[0] = cast(s32)corner; top.values[1] = cast(s32)corner
    side.values[0] = cast(s32)corner; side.values[1] = cast(s32)corner
    for i: 0..7 {
        if above[i] > maximum || left[i] > maximum { result.error = Error(InvalidInput); return result }
        top.values[i + 2] = cast(s32)above[i]; side.values[i + 2] = cast(s32)left[i]
    }
    angles: [8]s32 = .[90,180,45,135,113,157,203,67]
    angle := angles[mode - 1] + angle_delta * 3
    up_top: s32; up_side: s32
    if enable_edge_filter && angle != 90 && angle != 180 {
        if have_above { DirectionalFilterEdge(*top, ifx angle < 90 then 9 else 5, DirectionalStrength4x4(angle - 90, filter_type)) }
        if have_left { DirectionalFilterEdge(*side, ifx angle > 180 then 9 else 5, DirectionalStrength4x4(angle - 180, filter_type)) }
        delta := angle - 90; if delta < 0 { delta = -delta }
        if delta > 0 && delta < 40 { up_top = 1; DirectionalUpsampleEdge(*top, ifx angle < 90 then 8 else 4, maximum) }
        delta = angle - 180; if delta < 0 { delta = -delta }
        if delta > 0 && delta < 40 { up_side = 1; DirectionalUpsampleEdge(*side, ifx angle > 180 then 8 else 4, maximum) }
    }
    dx: s32; dy: s32
    if angle < 90 { dx = DirectionalDerivative(angle) }
    else if angle > 90 && angle < 180 { dx = DirectionalDerivative(180 - angle); dy = DirectionalDerivative(angle - 90) }
    else if angle > 180 { dy = DirectionalDerivative(270 - angle) }
    top_factor := 1 + up_top; side_factor := 1 + up_side
    samples: [16]u16
    for row: 0..3 {
        result.error = CancellationError(cancellation)
        if result.error.code != DecodeOK { return result }
        for column: 0..3 {
            value: s32
            if angle == 90 { value = cast(s32)above[column] }
            else if angle == 180 { value = cast(s32)left[row] }
            else {
                index: s32; base: s32; factor: s32
                use_top := angle < 180
                if angle < 90 {
                    index = (cast(s32)row + 1) * dx
                    base = DirectionalFloor(index, 64 / top_factor) + cast(s32)column * top_factor
                } else if angle < 180 {
                    index = cast(s32)column * 64 - (cast(s32)row + 1) * dx
                    base = DirectionalFloor(index, 64 / top_factor)
                    if base < -top_factor {
                        use_top = false
                        index = cast(s32)row * 64 - (cast(s32)column + 1) * dy
                        base = DirectionalFloor(index, 64 / side_factor)
                    }
                } else {
                    index = (cast(s32)column + 1) * dy
                    base = DirectionalFloor(index, 64 / side_factor) + cast(s32)row * side_factor
                }
                factor = ifx use_top then top_factor else side_factor
                shift := DirectionalFloor(index * factor, 2) % 32
                if shift < 0 { shift += 32 }
                maximum_base := 7 * factor
                if (angle < 90 || angle > 180) && base >= maximum_base {
                    value = ifx use_top then top.values[maximum_base + 2] else side.values[maximum_base + 2]
                } else {
                    if base < -2 || base > 13 { result.error = Error(MalformedInput); return result }
                    first := ifx use_top then top.values[base + 2] else side.values[base + 2]
                    second := ifx use_top then top.values[base + 3] else side.values[base + 3]
                    value = (first * (32 - shift) + second * shift + 16) / 32
                }
            }
            samples[row * 4 + column] = cast(u16)value
        }
    }
    result.samples = samples
    return result
}
