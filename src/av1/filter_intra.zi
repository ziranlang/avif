#import, file "./prediction.zi";
using Codec :: #import "image_codec/api"

// Probability/tap constants from libaom d772e334cc724105040382a977ebb10dfd393293,
// av1/common/{entropymode,reconintra}.c. Copyright (c) 2016, 2017 Alliance
// for Open Media. BSD 2-Clause and AOM Patent License retained in this directory.
FilterIntraCDF :: struct { enabled: [66]u16; mode: [6]u16; }
NewFilterIntraCDF :: () -> FilterIntraCDF {
    result: FilterIntraCDF
    probabilities: [22]u16 = .[4621,6743,5893,7866,12551,9394,12408,14301,12756,22343,16384,16384,16384,16384,16384,16384,12770,10368,20229,18101,16384,16384]
    for i: 0..21 { result.enabled[i * 3] = probabilities[i]; result.enabled[i * 3 + 1] = 32768 }
    modes: [6]u16 = .[8949,12776,17211,29558,32768,0]
    result.mode = modes
    return result
}

// AV1 BLOCK_SIZE enumeration, including the 1:4 and 4:1 extensions.
FilterIntraBlockIndex :: (width: s32, height: s32) -> s32 {
    widths: [22]s32 = .[4,4,8,8,8,16,16,16,32,32,32,64,64,64,128,128,4,16,8,32,16,64]
    heights: [22]s32 = .[4,8,4,8,16,8,16,32,16,32,64,32,64,128,64,128,16,4,32,8,64,16]
    for i: 0..21 { if widths[i] == width && heights[i] == height { return cast(s32)i } }
    return -1
}

// AV1 recursive intra prediction (7.11.2.3), for the current lossless4x4
// transform footprint. Edges/corner have already been extended by the caller.
// Every 4x2 group uses the previous predicted row, never its residual output.
PredictFilterIntra4x4 :: (above: []u16, left: []u16, corner: u16,
    filter_mode: s32, bit_depth: s32, cancellation: *Cancellation = null) -> Prediction4x4 {
    result: Prediction4x4
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    if above.count != 4 || left.count != 4 || (bit_depth != 8 && bit_depth != 10 && bit_depth != 12) ||
        filter_mode < 0 || filter_mode >= 5 { result.error = Error(InvalidInput); return result }
    maximum := cast(s32)((cast(u32)1 << cast(u32)bit_depth) - 1)
    if corner > maximum { result.error = Error(InvalidInput); return result }
    for i: 0..3 {
        if above[i] > maximum || left[i] > maximum { result.error = Error(InvalidInput); return result }
    }
    taps: [280]s8 = .[
        -6,10,0,0,0,12,0, -5,2,10,0,0,9,0, -3,1,1,10,0,7,0, -3,1,1,2,10,5,0,
        -4,6,0,0,0,2,12, -3,2,6,0,0,2,9, -3,2,2,6,0,2,7, -3,1,2,2,6,3,5,
        -10,16,0,0,0,10,0, -6,0,16,0,0,6,0, -4,0,0,16,0,4,0, -2,0,0,0,16,2,0,
        -10,16,0,0,0,0,10, -6,0,16,0,0,0,6, -4,0,0,16,0,0,4, -2,0,0,0,16,0,2,
        -8,8,0,0,0,16,0, -8,0,8,0,0,16,0, -8,0,0,8,0,16,0, -8,0,0,0,8,16,0,
        -4,4,0,0,0,0,16, -4,0,4,0,0,0,16, -4,0,0,4,0,0,16, -4,0,0,0,4,0,16,
        -2,8,0,0,0,10,0, -1,3,8,0,0,6,0, -1,2,3,8,0,4,0, 0,1,2,3,8,2,0,
        -1,4,0,0,0,3,10, -1,3,4,0,0,4,6, -1,2,3,4,0,4,4, -1,2,2,3,4,3,3,
        -12,14,0,0,0,14,0, -10,0,14,0,0,12,0, -9,0,0,14,0,11,0, -8,0,0,0,14,10,0,
        -10,12,0,0,0,0,14, -9,1,12,0,0,0,12, -8,0,0,12,0,1,11, -7,0,0,1,12,1,9]
    samples: [16]u16
    for group: 0..1 {
        result.error = CancellationError(cancellation)
        if result.error.code != DecodeOK { return result }
        neighbors: [7]s32
        neighbors[0] = ifx group == 0 then cast(s32)corner else cast(s32)left[group * 2 - 1]
        for column: 0..3 {
            neighbors[column + 1] = ifx group == 0 then cast(s32)above[column] else cast(s32)samples[(group * 2 - 1) * 4 + column]
        }
        neighbors[5] = cast(s32)left[group * 2]; neighbors[6] = cast(s32)left[group * 2 + 1]
        for k: 0..7 {
            sum: s32
            for i: 0..6 { sum += cast(s32)taps[(filter_mode * 8 + k) * 7 + i] * neighbors[i] }
            // Negative rounded values clip to zero, so this is equivalent to
            // Clip1(Round2Signed(sum,4)) without a signed-shift dependency.
            value := ifx sum <= 0 then 0 else (sum + 8) / 16
            if value > maximum { value = maximum }
            samples[group * 8 + k] = cast(u16)value
        }
    }
    result.samples = samples
    return result
}
