#import, file "./bits.zi";
#import, file "./profile.zi";

SequenceHeaderResult :: struct { header: SequenceHeader; error: DecodeError; }

#scope_file
Flag :: (bits: *BitReader) -> bool { return ReadBits(bits, 1) != 0 }
Field :: (bits: *BitReader, count: s32) -> s32 { return cast(s32)ReadBits(bits, count) }

// The uvlc terminator is still required when the value saturates at UINT32_MAX.
UVLC :: (bits: *BitReader) -> u32 {
    zeros: s32
    while bits.error.code == DecodeOK {
        if Flag(bits) { break }
        if zeros < 32 { zeros += 1 }
    }
    if bits.error.code != DecodeOK { return 0 }
    if zeros == 32 { return 4294967295 }
    suffix := ReadBits(bits, zeros)
    return suffix + ((cast(u32)1 << cast(u32)zeros) - 1)
}

ReadColorConfig :: (bits: *BitReader, header: *SequenceHeader) {
    high := Flag(bits)
    header.bit_depth = ifx high then 10 else 8
    if header.profile == 2 && high && Flag(bits) { header.bit_depth = 12 }
    if header.profile != 1 { header.monochrome = Flag(bits) }
    header.color_description_present = Flag(bits)
    header.color_primaries = 2; header.transfer_characteristics = 2; header.matrix_coefficients = 2
    if header.color_description_present {
        header.color_primaries = Field(bits, 8); header.transfer_characteristics = Field(bits, 8)
        header.matrix_coefficients = Field(bits, 8)
    }
    if header.monochrome {
        header.full_range = Flag(bits); header.subsampling_x = 1; header.subsampling_y = 1
        return
    }
    if header.color_primaries == 1 && header.transfer_characteristics == 13 && header.matrix_coefficients == 0 {
        header.full_range = true
    } else {
        header.full_range = Flag(bits)
        if header.profile == 0 { header.subsampling_x = 1; header.subsampling_y = 1 }
        else if header.profile == 2 {
            header.subsampling_x = 1
            if header.bit_depth == 12 {
                header.subsampling_x = Field(bits, 1)
                if header.subsampling_x != 0 { header.subsampling_y = Field(bits, 1) }
            }
        }
        if header.subsampling_x != 0 && header.subsampling_y != 0 { header.chroma_sample_position = Field(bits, 2) }
    }
    header.separate_uv_delta_q = Flag(bits)
}

#scope_export
// Parses a complete sequence-header payload, including required trailing bits.
// All three profiles are described; this does not assert frame-tool support.
// Fixed operating-point storage and the metadata cap bound work and memory.
ParseSequenceHeader :: (input: BorrowedBytes, begin: s64, end: s64, limits: DecodeLimits) -> SequenceHeaderResult {
    result: SequenceHeaderResult
    result.error = ValidateLimits(limits)
    if result.error.code != DecodeOK { return result }
    bits := NewBits(input, begin, end)
    if bits.error.code != DecodeOK { result.error = bits.error; return result }
    if end - begin > limits.max_metadata_bytes { result.error = Error(LimitExceeded, begin); return result }
    header: SequenceHeader
    for i: 0..31 { header.operating_points[i].initial_display_delay = 10 }
    header.profile = Field(*bits, 3)
    if header.profile > 2 { result.error = Error(UnsupportedCapability, begin); return result }
    header.still_picture = Flag(*bits); header.reduced_still_picture_header = Flag(*bits)
    if header.reduced_still_picture_header && !header.still_picture { result.error = Error(MalformedInput, begin); return result }
    if header.reduced_still_picture_header {
        header.operating_point_count = 1
        header.operating_points[0].level = Field(*bits, 5)
    } else {
        header.timing_info_present = Flag(*bits)
        if header.timing_info_present {
            header.num_units_in_display_tick = ReadBits(*bits, 32); header.time_scale = ReadBits(*bits, 32)
            header.equal_picture_interval = Flag(*bits)
            if header.equal_picture_interval { header.num_ticks_per_picture_minus_1 = UVLC(*bits) }
            header.decoder_model_info_present = Flag(*bits)
            if header.decoder_model_info_present {
                header.buffer_delay_length = Field(*bits, 5) + 1
                header.num_units_in_decoding_tick = ReadBits(*bits, 32)
                header.buffer_removal_time_length = Field(*bits, 5) + 1
                header.frame_presentation_time_length = Field(*bits, 5) + 1
            }
        }
        header.initial_display_delay_present = Flag(*bits)
        header.operating_point_count = Field(*bits, 5) + 1
        i: s32
        while i < header.operating_point_count {
            header.operating_points[i].idc = Field(*bits, 12)
            header.operating_points[i].level = Field(*bits, 5)
            if header.operating_points[i].level > 7 { header.operating_points[i].tier = Field(*bits, 1) }
            if header.decoder_model_info_present {
                header.operating_points[i].decoder_model_present = Flag(*bits)
                if header.operating_points[i].decoder_model_present {
                    header.operating_points[i].decoder_buffer_delay = ReadBits(*bits, header.buffer_delay_length)
                    header.operating_points[i].encoder_buffer_delay = ReadBits(*bits, header.buffer_delay_length)
                    header.operating_points[i].low_delay_mode = Flag(*bits)
                }
            }
            if header.initial_display_delay_present && Flag(*bits) { header.operating_points[i].initial_display_delay = Field(*bits, 4) + 1 }
            i += 1
        }
    }
    header.frame_width_bits = Field(*bits, 4) + 1; header.frame_height_bits = Field(*bits, 4) + 1
    header.max_frame_width = Field(*bits, header.frame_width_bits) + 1
    header.max_frame_height = Field(*bits, header.frame_height_bits) + 1
    if !header.reduced_still_picture_header { header.frame_id_numbers_present = Flag(*bits) }
    if header.frame_id_numbers_present {
        header.delta_frame_id_length = Field(*bits, 4) + 2
        header.frame_id_length = header.delta_frame_id_length + Field(*bits, 3) + 1
    }
    header.use_128x128_superblock = Flag(*bits); header.enable_filter_intra = Flag(*bits); header.enable_intra_edge_filter = Flag(*bits)
    header.force_screen_content_tools = 2; header.force_integer_mv = 2
    if !header.reduced_still_picture_header {
        header.enable_interintra_compound = Flag(*bits); header.enable_masked_compound = Flag(*bits)
        header.enable_warped_motion = Flag(*bits); header.enable_dual_filter = Flag(*bits); header.enable_order_hint = Flag(*bits)
        if header.enable_order_hint { header.enable_jnt_comp = Flag(*bits); header.enable_ref_frame_mvs = Flag(*bits) }
        if !Flag(*bits) { header.force_screen_content_tools = Field(*bits, 1) }
        if header.force_screen_content_tools > 0 && !Flag(*bits) { header.force_integer_mv = Field(*bits, 1) }
        if header.enable_order_hint { header.order_hint_bits = Field(*bits, 3) + 1 }
    }
    header.enable_superres = Flag(*bits); header.enable_cdef = Flag(*bits); header.enable_restoration = Flag(*bits)
    ReadColorConfig(*bits, *header)
    header.film_grain_params_present = Flag(*bits)
    result.error = FinishBits(*bits)
    if result.error.code != DecodeOK { return result }
    result.error = ValidateDimensions(header.max_frame_width, header.max_frame_height, limits)
    if result.error.code != DecodeOK { result.error.offset = begin; return result }
    if header.frame_id_length > 16 || (header.timing_info_present && (header.num_units_in_display_tick == 0 || header.time_scale == 0)) ||
        (header.equal_picture_interval && header.num_ticks_per_picture_minus_1 == 4294967295) ||
        (header.decoder_model_info_present && header.num_units_in_decoding_tick == 0) || header.chroma_sample_position == 3 ||
        (header.matrix_coefficients == 0 && (header.subsampling_x != 0 || header.subsampling_y != 0)) {
        result.error = Error(MalformedInput, begin); return result
    }
    if !header.monochrome && ((header.profile == 0 && (header.subsampling_x != 1 || header.subsampling_y != 1)) ||
        (header.profile == 2 && header.bit_depth != 12 && (header.subsampling_x != 1 || header.subsampling_y != 0))) {
        result.error = Error(MalformedInput, begin); return result
    }
    for i: 0..header.operating_point_count - 1 {
        idc := header.operating_points[i].idc
        if idc != 0 && ((idc & 255) == 0 || (idc & 3840) == 0) { result.error = Error(MalformedInput, begin); return result }
        j: s32
        while j < i {
            if header.operating_points[j].idc == idc { result.error = Error(MalformedInput, begin); return result }
            j += 1
        }
    }
    result.header = header
    return result
}
