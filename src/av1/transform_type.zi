using Codec :: #import "image_codec/api"
#import, file "coefficient_geometry.zi";
#import, file "range.zi";
#import, file "transform_type_data.zi";

TransformTypeCDFs :: struct { values: [501]u16; error: DecodeError; }
TransformTypeSelection :: struct { set: s32; square: s32; offset: s32; count: s32; error: DecodeError; }
TransformTypeResult :: struct { value: s32; tx_class: s32; error: DecodeError; }

NewTransformTypeCDFs :: (cancellation: *Cancellation = null) -> TransformTypeCDFs {
    result: TransformTypeCDFs; result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    result.values = TransformTypeCDFData()
    result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK {
        failed: TransformTypeCDFs; failed.error = result.error; return failed
    }
    return result
}

// set numbers are AV1's separate intra1/2 and inter1/2/3 sets, not native
// EXT_TX_SET enum values. The caller resolves filter-intra's effective mode.
SelectTransformType :: (width: s32, height: s32, is_inter: bool,
    reduced: bool, mode: s32) -> TransformTypeSelection {
    result: TransformTypeSelection
    shape := GetCoefficientShape(width, height)
    if shape.error.code != DecodeOK { result.error = shape.error; return result }
    if mode < 0 || mode > 12 { result.error = Error(InvalidInput); return result }
    high := ifx width > height then width else height; low := ifx width < height then width else height
    if high > 32 || (!is_inter && high == 32) { return result }
    square: s32; side: s32 = 4
    while side < low { side *= 2; square += 1 }
    result.square = square
    if !is_inter {
        if reduced || low == 16 {
            result.set = 2; result.count = 6
            result.offset = 208 + (square * 13 + mode) * 6
        } else {
            result.set = 1; result.count = 8
            result.offset = (square * 13 + mode) * 8
        }
    } else if reduced || high == 32 {
        result.set = 3; result.count = 3; result.offset = 489 + square * 3
    } else if low == 16 {
        result.set = 2; result.count = 13; result.offset = 476
    } else {
        result.set = 1; result.count = 17; result.offset = 442 + square * 17
    }
    return result
}

// Check membership using AV1 tx type numbers0..15. All geometry and shifts
// are bounded before access. Type0 is DCT_DCT,9 IDTX,10/11 V_DCT/H_DCT.
TransformTypeInSet :: (selection: TransformTypeSelection, is_inter: bool, value: s32) -> bool {
    if selection.error.code != DecodeOK || value < 0 || value > 15 || selection.set < 0 ||
        selection.set > 3 || (!is_inter && selection.set > 2) { return false }
    if selection.set == 0 { return value == 0 }
    if !is_inter {
        return value <= 3 || value == 9 || (selection.set == 1 && (value == 10 || value == 11))
    }
    if selection.set == 1 { return true }
    if selection.set == 2 { return value <= 11 }
    return value == 0 || value == 9
}

TransformClass :: (value: s32) -> s32 {
    if value < 10 || value > 15 { return 0 }
    return ifx (value & 1) == 0 then 2 else 1
}

// Called only for nonzero luma, after all_zero and before EOB. syntax_q_index
// is the frame base Q or segmentation get_qindex(ignoreDelta=1), not block
// delta-Q. filter_mode=-1 uses YMode;0..4 selects the normative filter mapping.
ReadTransformType :: (decoder: *RangeDecoder, cdfs: *TransformTypeCDFs,
    width: s32, height: s32, is_inter: bool, reduced: bool, syntax_q_index: s32,
    mode: s32, filter_mode: s32 = -1, cancellation: *Cancellation = null) -> TransformTypeResult {
    result: TransformTypeResult; result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    if decoder == null || cdfs == null || syntax_q_index < 0 || syntax_q_index > 255 ||
        mode < 0 || mode > 12 || filter_mode < -1 || filter_mode > 4 || (is_inter && filter_mode != -1) {
        result.error = Error(InvalidInput); return result
    }
    if cdfs.error.code != DecodeOK { result.error = cdfs.error; return result }
    if decoder.error.code != DecodeOK { result.error = decoder.error; return result }
    effective := mode
    if filter_mode >= 0 {
        directions: [5]s32 = .[0,1,2,6,0]; effective = directions[filter_mode]
    }
    selection := SelectTransformType(width, height, is_inter, reduced, effective)
    if selection.error.code != DecodeOK { result.error = selection.error; return result }
    if syntax_q_index == 0 || selection.set == 0 { return result }
    symbol := ReadSymbol(decoder, cdfs.values[selection.offset:selection.offset + selection.count])
    if decoder.error.code != DecodeOK { result.error = decoder.error; return result }
    intra1: [7]s32 = .[9,0,10,11,3,1,2]
    intra2: [5]s32 = .[9,0,3,1,2]
    inter1: [16]s32 = .[9,10,11,12,13,14,15,0,1,2,4,5,3,6,7,8]
    inter2: [12]s32 = .[9,10,11,0,1,2,4,5,3,6,7,8]
    inter3: [2]s32 = .[9,0]
    if !is_inter { result.value = ifx selection.set == 1 then intra1[symbol] else intra2[symbol] }
    else if selection.set == 1 { result.value = inter1[symbol] }
    else if selection.set == 2 { result.value = inter2[symbol] }
    else { result.value = inter3[symbol] }
    result.tx_class = TransformClass(result.value)
    return result
}

// Chroma has no transform-type entropy syntax. Intra uses its UV prediction
// mode (13 is CfL); inter uses the caller's resolved luma transform at the
// corresponding subsampled position. Unsupported-in-set types fall back to DCT.
ResolveChromaTransformType :: (width: s32, height: s32, is_inter: bool,
    reduced: bool, lossless: bool, mode_or_luma_type: s32,
    cancellation: *Cancellation = null) -> TransformTypeResult {
    result: TransformTypeResult; result.error = CancellationError(cancellation)
    if result.error.code != DecodeOK { return result }
    selection := SelectTransformType(width, height, is_inter, reduced, 0)
    if selection.error.code != DecodeOK { result.error = selection.error; return result }
    maximum := ifx is_inter then 15 else 13
    if mode_or_luma_type < 0 || mode_or_luma_type > maximum { result.error = Error(InvalidInput); return result }
    if lossless { return result }
    value := mode_or_luma_type
    if !is_inter {
        map: [14]s32 = .[0,1,2,0,3,1,2,2,1,3,1,2,3,0]; value = map[mode_or_luma_type]
    }
    if TransformTypeInSet(selection, is_inter, value) { result.value = value; result.tx_class = TransformClass(value) }
    return result
}
