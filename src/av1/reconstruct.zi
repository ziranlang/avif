using Codec :: #import "image_codec/api"

// Scalar semantic reference for a zero-residual DC block with no available
// top/left border. Storage is owned by the caller; samples are little endian.
ReconstructZeroDC8x8 :: (plane: *Plane, bit_depth: s32, cancellation: *Cancellation = null) -> DecodeError {
    error := CancellationError(cancellation)
    if error.code != DecodeOK { return error }
    if plane == null || (bit_depth != 8 && bit_depth != 10 && bit_depth != 12) { return Error(InvalidInput) }
    sample_bytes: s32 = ifx bit_depth == 8 then 1 else 2
    if plane.width != 8 || plane.height != 8 || plane.sample_bytes != sample_bytes || plane.stride < 8 * sample_bytes {
        return Error(InvalidInput)
    }
    bytes, span_error := RequiredSpan(8, 8, sample_bytes, plane.stride)
    if span_error.code != DecodeOK { return span_error }
    if bytes > plane.storage.count { return Error(OutputTooSmall) }
    value := cast(u32)1 << cast(u32)(bit_depth - 1)
    for row: 0..7 {
        error = CancellationError(cancellation)
        if error.code != DecodeOK { return error }
        for column: 0..7 {
            at := row * plane.stride + column * sample_bytes
            plane.storage[at] = cast(u8)(value & 255)
            if sample_bytes == 2 { plane.storage[at + 1] = cast(u8)(value >> 8) }
        }
    }
    return Error(DecodeOK)
}
