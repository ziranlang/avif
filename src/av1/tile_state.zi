#import, file "./range.zi";
#import, file "./cdfs4.zi";
#import, file "./partition.zi";
#import, file "./modes.zi";
#import, file "./filter_intra.zi";
#import, file "./palette.zi";
#import, file "./palette_cdfs.zi";
#import, file "./palette_uv_cdfs.zi";
#import, file "./chroma_cdfs.zi";
using Codec :: #import "image_codec/api"

// Fixed, tile-owned state. Y and the two chroma planes are independent; U/V
// share probability models, with separate coefficient neighbor contexts.
DecodedLosslessStill :: struct { samples: [4096]u16; u_samples: [4096]u16; v_samples: [4096]u16; width: s32; height: s32; chroma_width: s32; chroma_height: s32; error: DecodeError; }
LosslessTile :: struct {
    decoder: RangeDecoder;
    coefficients: CoeffCDF4x4;
    chroma_coefficients: CoeffCDF4x4;
    chroma_modes: ChromaModeCDF;
    partitions: PartitionCDF;
    skip_cdf: [9]u16;
    mode_cdfs: IntraModeCDF;
    palette_cdfs: PaletteCDF;
    palette: PaletteBlock;
    palette_sizes: [256]u8;
    palette_colors: [2048]u16;
    uv_palette_cdfs: PaletteUVCDF;
    uv_palette: PaletteBlock;
    uv_palette_sizes: [256]u8;
    uv_palette_colors: [2048]u16;
    filter_cdfs: FilterIntraCDF;
    result: DecodedLosslessStill;
    above_level: [16]s32;
    left_level: [16]s32;
    above_dc: [16]s32;
    left_dc: [16]s32;
    block_width: [256]u8;
    block_height: [256]u8;
    block_skip: [256]u8;
    block_mode: [256]u8;
    block_decoded: [256]u8;
    uv_decoded: [256]u8;
    uv_mode: [256]u8;
    uv_above_level: [32]s32;
    uv_left_level: [32]s32;
    uv_above_dc: [32]s32;
    uv_left_dc: [32]s32;
    has_chroma: bool;
    subsampling_x: s32;
    subsampling_y: s32;
    bit_depth: s32;
    nodes: s32;
    screen_tools: bool;
    filter_intra: bool;
    edge_filter: bool;
    cancellation: *Cancellation;
}
