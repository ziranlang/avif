#import, file "./obu.zi";
#import, file "./headers.zi";
#import, file "./frame.zi";
#import, file "./tilegroup.zi";
#import, file "./entropy.zi";
#import, file "./tile_state.zi";
#import, file "./profile.zi";
#import, file "./state.zi";
#import, file "./reconstruct.zi";
#import, file "./grain_apply.zi";
using Codec :: #import "image_codec/api"

// Owned source-domain samples, independent of the encoded input. Monochrome
// returns Y alone; color returns independent Y/U/V planes of the source depth.
Av1YUVResult :: struct {
    is_ok: bool;
    sequence: SequenceHeader;
    frame: StillFrameHeader;
    y: Plane;
    u: Plane;
    v: Plane;
    error: DecodeError;
}
Av1Failure :: (error: DecodeError) -> Av1YUVResult {
    result: Av1YUVResult
    result.error = error
    if error.code == DecodeOK { result.error = Error(InvalidInput) }
    return result
}

// Conservative bound for this bounded <=64x64 path's control records and scalar CDFs,
// excluding the borrowed input and caller-owned bounded output. No dynamic
// scratch buffers or references exist. This is not a process RSS claim.
Av1StillWorkingBytes :: 1048576;

// Initial authored subset, not a full AV1 engine: 8/10/12-bit mono/420/422/444,
// shown KEY headers, implemented lossless intra modes/partitions, film grain and one tile. Other
// tools reject; no bridge or native decoder is called. Do not switch the AVIF
// default until the full required frame/plane corpus passes.
DecodeAv1YUV :: (input: BorrowedBytes, options: *DecodeOptions) -> Av1YUVResult {
    error := ValidateOptions(options)
    if error.code != DecodeOK { return Av1Failure(error) }
    if options.color_mode != StrictColor { return Av1Failure(Error(UnsupportedCapability)) }
    error = ValidateInputSize(input.data.count, options.limits)
    if error.code != DecodeOK { return Av1Failure(error) }
    error = ValidateDecodedFrames(1, options.limits)
    if error.code != DecodeOK { return Av1Failure(error) }
    local_budget := NewWorkerBudget(options.limits)
    budget := options.workers
    if budget == null { budget = *local_budget }
    error = AcquireWorker(budget, options.cancellation)
    if error.code != DecodeOK { return Av1Failure(error) }
    defer { unused ReleaseWorker(budget) }
    error = ReserveWorkingBytes(budget, Av1StillWorkingBytes, options.cancellation)
    if error.code != DecodeOK { return Av1Failure(error) }
    defer { unused ReleaseWorkingBytes(budget, Av1StillWorkingBytes) }
    sequence: SequenceHeader
    frame: StillFrameHeader
    decoded: DecodedLosslessStill
    grain_picture: GrainPicture; have_grain := false
    have_sequence := false; have_frame := false
    at: s64
    count: s32
    while at < input.data.count {
        error = CancellationError(options.cancellation)
        if error.code != DecodeOK { return Av1Failure(error) }
        if count >= 4096 { return Av1Failure(Error(LimitExceeded, at)) }
        obu := ReadOBU(input, at, input.data.count)
        if obu.error.code != DecodeOK { return Av1Failure(obu.error) }
        item := obu.obu
        if item.has_extension { return Av1Failure(Error(UnsupportedCapability, at)) }
        if item.kind == Av1SequenceHeader {
            if have_sequence || have_frame { return Av1Failure(Error(UnsupportedCapability, at)) }
            parsed := ParseSequenceHeader(input, item.payload, item.end, options.limits)
            if parsed.error.code != DecodeOK { return Av1Failure(parsed.error) }
            sequence = parsed.header; have_sequence = true
            if sequence.max_frame_width < 1 || sequence.max_frame_width > 64 || sequence.max_frame_height < 1 || sequence.max_frame_height > 64 { return Av1Failure(Error(UnsupportedCapability, item.payload)) }
        } else if item.kind == Av1Frame {
            if !have_sequence { return Av1Failure(Error(MalformedInput, at)) }
            if have_frame { return Av1Failure(Error(UnsupportedCapability, at)) }
            parsed := ParseStillFrameHeader(input, item.payload, item.end, sequence, options.limits)
            if parsed.error.code != DecodeOK { return Av1Failure(parsed.error) }
            frame = parsed.header
            if !frame.all_lossless || frame.segmentation_enabled ||
                frame.allow_intrabc || frame.tiles.columns != 1 || frame.tiles.rows != 1 {
                return Av1Failure(Error(UnsupportedCapability, item.payload))
            }
            group := NewTileGroup(input, parsed.next, item.end, frame.tiles, options.cancellation)
            tile := NextTileSpan(*group)
            if tile.error.code != DecodeOK { return Av1Failure(tile.error) }
            if !tile.has_tile { return Av1Failure(Error(TruncatedInput, item.end)) }
            decoded = DecodeLosslessStill(input, tile.tile.begin, tile.tile.end, sequence.bit_depth, frame.width, frame.height, frame.disable_cdf_update,
                options.cancellation, frame.allow_screen_content_tools, sequence.enable_filter_intra, sequence.enable_intra_edge_filter,
                sequence.monochrome, sequence.subsampling_x, sequence.subsampling_y)
            if decoded.error.code != DecodeOK { return Av1Failure(decoded.error) }
            if frame.grain_parameters.apply_grain {
                view: GrainPictureView
                view.y = decoded.samples[:]; view.u = decoded.u_samples[:]; view.v = decoded.v_samples[:]
                view.y_stride = decoded.width; view.chroma_stride = decoded.chroma_width
                view.width = frame.width; view.height = frame.height; view.monochrome = sequence.monochrome
                view.subsampling_x = sequence.subsampling_x; view.subsampling_y = sequence.subsampling_y
                view.bit_depth = sequence.bit_depth; view.matrix_identity = sequence.matrix_coefficients == 0
                grain_picture = ApplyFilmGrain64(view, frame.grain_parameters, options.cancellation)
                if grain_picture.error.code != DecodeOK { return Av1Failure(grain_picture.error) }
                have_grain = true
            }
            have_frame = true
        } else if item.kind == Av1TemporalDelimiter {
            if have_frame { return Av1Failure(Error(UnsupportedCapability, at)) }
            if item.payload != item.end { return Av1Failure(Error(MalformedInput, item.payload)) }
        } else if item.kind != Av1Padding {
            return Av1Failure(Error(UnsupportedCapability, at))
        }
        at = item.end; count += 1
    }
    if !have_sequence || !have_frame { return Av1Failure(Error(TruncatedInput, input.data.count)) }
    sample_bytes: s32 = ifx sequence.bit_depth == 8 then 1 else 2
    sub_x := sequence.subsampling_x
    sub_y := sequence.subsampling_y
    chroma_width := (frame.width + sub_x) / (1 + sub_x)
    chroma_height := (frame.height + sub_y) / (1 + sub_y)
    output_bytes := cast(s64)frame.width * frame.height * sample_bytes
    if !sequence.monochrome { output_bytes += cast(s64)2 * chroma_width * chroma_height * sample_bytes }
    if options.limits.max_output_bytes < output_bytes { return Av1Failure(Error(LimitExceeded)) }
    result: Av1YUVResult
    result.sequence = sequence; result.frame = frame
    last_plane := ifx sequence.monochrome then 0 else 2
    for index: 0..last_plane {
        plane := *result.y
        source := decoded.samples[:]; source_stride := decoded.width
        if have_grain { source = grain_picture.y[:]; source_stride = 64 }
        width := frame.width; height := frame.height
        if index > 0 {
            width = chroma_width; height = chroma_height; source_stride = decoded.chroma_width
            if index == 1 { plane = *result.u; source = decoded.u_samples[:] }
            else { plane = *result.v; source = decoded.v_samples[:] }
            if have_grain {
                source_stride = 64
                source = ifx index == 1 then grain_picture.u[:] else grain_picture.v[:]
            }
        }
        plane.width = width; plane.height = height; plane.stride = width * sample_bytes; plane.sample_bytes = sample_bytes
        plane_bytes := cast(s64)width * height * sample_bytes
        if !VecResizeBounded(plane.storage, plane_bytes, plane_bytes) { return Av1Failure(Error(AllocationFailed)) }
        for row: 0..height - 1 {
        error = CancellationError(options.cancellation)
        if error.code != DecodeOK { return Av1Failure(error) }
        for column: 0..width - 1 {
            value := source[row * source_stride + column]
            at := row * plane.stride + column * sample_bytes
            plane.storage[at] = cast(u8)(value & 255)
            if sample_bytes == 2 { plane.storage[at + 1] = cast(u8)(value >> 8) }
        }
        }
    }
    result.is_ok = true
    return result
}
