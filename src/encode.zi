// Optional native encoding; no static links or UI dependency.
using Bridge :: #import "bridge"
using Output :: #import "output"
#import "bmff"
#import "std/byte_text_linux"
EncodeMetadata :: struct { icc: []u8; exif: []u8; xmp: []u8; orientation: s32; source_bit_depth: s32; frame_count: s32; }
DefaultEncodeMetadata :: () -> EncodeMetadata {
    metadata: EncodeMetadata
    metadata.orientation = 1; metadata.source_bit_depth = 8; metadata.frame_count = 1
    return metadata
}
EncodeOptions :: struct { quality: s32; limits: DecodeLimits; cancellation: *Cancellation; workers: *WorkerBudget; }
DefaultEncodeOptions :: () -> EncodeOptions {
    options: EncodeOptions
    options.quality = 35; options.limits = DefaultLimits()
    return options
}
EncodeResult :: struct { is_ok: bool; bytes: Vec(u8); width: s32; height: s32; error: DecodeError; }
EncodeFailure :: (error: DecodeError) -> EncodeResult { result: EncodeResult; result.error = error; return result }
// Prefix of pinned 1.3.0. Only libavif allocates it; ABI tests cover touched fields.
RawEncoder :: struct {
    codec: s32; threads: s32; speed: s32; keyframe_interval: s32; timescale: u64
    repetitions: s32; extra_layers: u32; quality: s32; alpha_quality: s32
}
AvifImageCreate :: #type (width: u32, height: u32, depth: u32, format: s32) -> *RawImage #c_call;
AvifImageDestroy :: #type (image: *RawImage) -> void #c_call;
AvifSetMetadata :: #type (image: *RawImage, data: *u8, count: usize) -> s32 #c_call;
AvifEncoderCreate :: #type () -> *RawEncoder #c_call;
AvifEncoderDestroy :: #type (encoder: *RawEncoder) -> void #c_call;
AvifEncoderWrite :: #type (encoder: *RawEncoder, image: *RawImage, output: *RawBytes) -> s32 #c_call;
AvifDataFree :: #type (data: *RawBytes) -> void #c_call;
AvifEncodeAPI :: struct {
    version: AvifVersion; image_create: AvifImageCreate; image_destroy: AvifImageDestroy
    defaults: AvifDefaults; from_rgb: AvifConvert
    icc: AvifSetMetadata; exif: AvifSetMetadata; xmp: AvifSetMetadata
    create: AvifEncoderCreate; destroy: AvifEncoderDestroy; write: AvifEncoderWrite; free: AvifDataFree
}
ValidateEncodeAPI :: (api: AvifEncodeAPI) -> DecodeError {
    if api.version == null || api.image_create == null || api.image_destroy == null || api.defaults == null ||
       api.from_rgb == null || api.icc == null || api.exif == null || api.xmp == null || api.create == null ||
       api.destroy == null || api.write == null || api.free == null { return Error(UnsupportedCapability) }
    if TextFromCString(api.version()) != "1.3.0" { return Error(UnsupportedCapability) }
    return Error(DecodeOK)
}
EncodeNativeError :: (code: s32) -> DecodeError {
    if code == 0 { return Error(DecodeOK) }
    if code == 6 || code == 7 || code == 15 || code == 25 { return Error(UnsupportedCapability) }
    if code == 26 { return Error(AllocationFailed) }
    return Error(MalformedInput)
}
// No resize or orientation bake: AVIF transforms carry the stored-pixel orientation.
EncodeRGBA8WithAPI :: (api: AvifEncodeAPI, source: RgbaView, metadata: EncodeMetadata, options: EncodeOptions) -> EncodeResult {
    error := ValidateLimits(options.limits)
    if error.code != DecodeOK { return EncodeFailure(error) }
    if options.quality < 1 || options.quality > 100 || metadata.orientation < 1 || metadata.orientation > 8 { return EncodeFailure(Error(InvalidInput)) }
    if metadata.source_bit_depth != 8 || metadata.frame_count != 1 { return EncodeFailure(Error(UnsupportedCapability)) }
    error = ValidateRgba(source, options.limits)
    if error.code != DecodeOK { return EncodeFailure(error) }
    if source.width > 32768 || source.height > 32768 || cast(s64)source.width * source.height > 67108864 || source.stride > 4294967295 { return EncodeFailure(Error(LimitExceeded)) }
    if source.data.count > options.limits.max_input_bytes || source.data.count > 268435456 { return EncodeFailure(Error(LimitExceeded)) }
    metadata_limit := options.limits.max_metadata_bytes
    if metadata_limit > 1048576 { metadata_limit = 1048576 }
    metadata_bytes: s64 = 0
    counts: [3]s64 = .[metadata.icc.count, metadata.exif.count, metadata.xmp.count]
    for count: counts {
        if count < 0 { return EncodeFailure(Error(InvalidInput)) }
        if count > metadata_limit - metadata_bytes { return EncodeFailure(Error(LimitExceeded)) }
        metadata_bytes += count
    }
    // YUV444 and alpha storage. Opaque codec allocations are not a hard RSS guarantee.
    working := cast(s64)source.width * source.height * 4
    if working > options.limits.max_working_bytes { return EncodeFailure(Error(LimitExceeded)) }
    error = CancellationError(options.cancellation)
    if error.code == DecodeOK { error = ValidateEncodeAPI(api) }
    if error.code != DecodeOK { return EncodeFailure(error) }
    acquired := false; reserved := false
    if options.workers != null {
        error = ValidateWorkerBudget(options.workers, options.limits)
        if error.code == DecodeOK { error = AcquireWorker(options.workers, options.cancellation) }
        if error.code != DecodeOK { return EncodeFailure(error) }
        acquired = true
    }
    defer { if acquired { unused ReleaseWorker(options.workers) } }
    if acquired {
        error = ReserveWorkingBytes(options.workers, working, options.cancellation)
        if error.code != DecodeOK { return EncodeFailure(error) }
        reserved = true
    }
    defer { if reserved { unused ReleaseWorkingBytes(options.workers, working) } }
    image := api.image_create(cast(u32)source.width, cast(u32)source.height, 8, 1)
    if image == null { return EncodeFailure(Error(AllocationFailed)) }
    defer { api.image_destroy(image) }
    image.range = 1; image.primaries = 1; image.transfer = 13; image.matrix = 0 // full-range identity GBR, YUV444
    if metadata.icc.count != 0 { error = EncodeNativeError(api.icc(image, *metadata.icc[0], cast(usize)metadata.icc.count)) }
    if error.code == DecodeOK && metadata.exif.count != 0 { error = EncodeNativeError(api.exif(image, *metadata.exif[0], cast(usize)metadata.exif.count)) }
    if error.code == DecodeOK && metadata.xmp.count != 0 { error = EncodeNativeError(api.xmp(image, *metadata.xmp[0], cast(usize)metadata.xmp.count)) }
    if error.code != DecodeOK { return EncodeFailure(error) }
    // Exif setter can set these too; the explicit stored-pixel orientation wins.
    image.transforms = 0; image.rotation = 0; image.mirror = 0
    angle: u8 = 0; mirror: s32 = -1
    if metadata.orientation == 2 { mirror = 1 }
    else if metadata.orientation == 3 { angle = 2 }
    else if metadata.orientation == 4 { mirror = 0 }
    else if metadata.orientation == 5 { angle = 1; mirror = 0 }
    else if metadata.orientation == 6 { angle = 3 }
    else if metadata.orientation == 7 { angle = 1; mirror = 1 }
    else if metadata.orientation == 8 { angle = 1 }
    if angle != 0 { image.transforms |= 4; image.rotation = angle }
    if mirror >= 0 { image.transforms |= 8; image.mirror = cast(u8)mirror }
    rgb: RawRGB
    api.defaults(*rgb, image)
    rgb.depth = 8; rgb.format = 1; rgb.premultiplied = 0; rgb.threads = 1
    rgb.ignore_alpha = 0; rgb.pixels = *source.data[0]; rgb.row_bytes = cast(u32)source.stride
    error = EncodeNativeError(api.from_rgb(image, *rgb))
    if error.code == DecodeOK { error = CancellationError(options.cancellation) }
    if error.code != DecodeOK { return EncodeFailure(error) }
    return EncodeNativeImage(api, image, options)
}
#scope_file
// Shared write boundary for RGBA input and AVIF transcodes.
EncodeNativeImage :: (api: AvifEncodeAPI, image: *RawImage, options: EncodeOptions) -> EncodeResult {
    error := CancellationError(options.cancellation)
    if error.code != DecodeOK { return EncodeFailure(error) }
    encoder := api.create()
    if encoder == null { return EncodeFailure(Error(AllocationFailed)) }
    defer { api.destroy(encoder) }
    encoder.codec = CodecLibaom; encoder.threads = 1; encoder.speed = 8
    encoder.quality = options.quality; encoder.alpha_quality = 100
    encoded: RawBytes
    defer { api.free(*encoded) }
    error = EncodeNativeError(api.write(encoder, image, *encoded))
    if error.code == DecodeOK { error = CancellationError(options.cancellation) }
    if error.code != DecodeOK { return EncodeFailure(error) }
    if encoded.size == 0 || encoded.data == null { return EncodeFailure(Error(MalformedInput)) }
    if encoded.size > cast(usize)options.limits.max_output_bytes || encoded.size > 268435456 { return EncodeFailure(Error(LimitExceeded)) }
    result: EncodeResult
    count := cast(s64)encoded.size
    if !VecResizeBounded(result.bytes, count, count) { return EncodeFailure(Error(AllocationFailed)) }
    for index: 0..count - 1 { result.bytes[index] = encoded.data[index] }
    result.width = cast(s32)image.width; result.height = cast(s32)image.height; result.is_ok = true
    return result
}
#scope_export
// Re-encode a still 8-bit AVIF retaining metadata and transforms.
ReencodeWithAPI :: (decode_api: AvifAPI, api: AvifEncodeAPI, input: BorrowedBytes, options: EncodeOptions) -> EncodeResult {
    error := ValidateLimits(options.limits)
    if error.code == DecodeOK { error = ValidateInputSize(input.data.count, options.limits) }
    if error.code != DecodeOK { return EncodeFailure(error) }
    if options.quality < 1 || options.quality > 100 { return EncodeFailure(Error(InvalidInput)) }
    if input.data.count > 268435456 { return EncodeFailure(Error(LimitExceeded)) }
    error = ValidateContainer(input)
    if error.code == DecodeOK { error = Preflight(input, options.limits) }
    if error.code == DecodeOK { error = ValidateAPI(decode_api) }
    if error.code == DecodeOK && TextFromCString(decode_api.version()) != "1.3.0" { error = Error(UnsupportedCapability) }
    if error.code == DecodeOK { error = ValidateEncodeAPI(api) }
    if error.code == DecodeOK { error = CancellationError(options.cancellation) }
    if error.code != DecodeOK { return EncodeFailure(error) }
    acquired := false
    if options.workers != null {
        error = ValidateWorkerBudget(options.workers, options.limits)
        if error.code == DecodeOK { error = AcquireWorker(options.workers, options.cancellation) }
        if error.code != DecodeOK { return EncodeFailure(error) }
        acquired = true
    }
    defer { if acquired { unused ReleaseWorker(options.workers) } }
    decoder := decode_api.create()
    if decoder == null { return EncodeFailure(Error(AllocationFailed)) }
    defer { decode_api.destroy(decoder) }
    decoder.codec = CodecDav1d; decoder.threads = 1; decoder.ignore_exif = 0; decoder.ignore_xmp = 0
    decoder.size_limit = 67108864; decoder.dimension_limit = 32768; decoder.count_limit = 4096
    error = EncodeNativeError(decode_api.memory(decoder, *input.data[0], cast(usize)input.data.count))
    if error.code == DecodeOK { error = EncodeNativeError(decode_api.parse(decoder)) }
    if error.code != DecodeOK { return EncodeFailure(error) }
    image := decoder.image
    if image == null { return EncodeFailure(Error(MalformedInput)) }
    if decoder.image_count != 1 || image.depth != 8 || image.gain_map != null || image.transfer == 16 || image.transfer == 18 || image.property_count != 0 { return EncodeFailure(Error(UnsupportedCapability)) }
    error = ValidatePixelDimensions(cast(s32)image.width, cast(s32)image.height, options.limits)
    if error.code != DecodeOK { return EncodeFailure(error) }
    metadata_limit := cast(usize)options.limits.max_metadata_bytes
    if metadata_limit > 1048576 { metadata_limit = 1048576 }
    metadata_bytes: usize = 0
    counts: [3]usize = .[image.icc.size, image.exif.size, image.xmp.size]
    for count: counts {
        if count > metadata_limit - metadata_bytes { return EncodeFailure(Error(LimitExceeded)) }
        metadata_bytes += count
    }
    working := cast(s64)image.width * image.height * 4
    if working > options.limits.max_working_bytes { return EncodeFailure(Error(LimitExceeded)) }
    reserved := false
    if acquired {
        error = ReserveWorkingBytes(options.workers, working, options.cancellation)
        if error.code != DecodeOK { return EncodeFailure(error) }
        reserved = true
    }
    defer { if reserved { unused ReleaseWorkingBytes(options.workers, working) } }
    width := image.width; height := image.height
    error = EncodeNativeError(decode_api.next(decoder))
    if error.code != DecodeOK { return EncodeFailure(error) }
    if decoder.image == null { return EncodeFailure(Error(MalformedInput)) }
    if width != decoder.image.width || height != decoder.image.height || decoder.image.depth != 8 { return EncodeFailure(Error(MalformedInput)) }
    return EncodeNativeImage(api, decoder.image, options)
}
