using Engine :: #import "engine"
#import "static"
#scope_file
// libaom is built without CONFIG_MULTITHREAD, so its AV1 decode stays on one
// thread; one-thread conversion keeps the oracle identical to the prior path.
AomDecode :: (input: BorrowedBytes, options: *DecodeOptions) -> DecodeResult { return BridgeDecode(StaticAPI(), input, options, CodecLibaom, 1) }
#scope_export
LibaomEngine :: () -> Av1Engine {
    caps := EngineCapabilities.{true, false, true, false, false, false, false, 1}
    return Av1Engine.{"libavif-1.3.0/libaom-3.13.1", caps, AomDecode}
}
