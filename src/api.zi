using Engine :: #import "engine"
#import "libaom"
#import "dav1d"
// First complete frame, owned std/image.Image with straight RGBA8 pixels.
Decode :: (input: BorrowedBytes, options: DecodeOptions) -> DecodeResult {
    return DecodeWithEngine(DefaultEngine(), input, *options)
}

// dav1d is the default engine; libaom is the explicit comparison oracle.
DefaultEngine :: () -> Av1Engine { return Dav1dEngine() }
LibaomOracle :: () -> Av1Engine { return LibaomEngine() }
// Static hosts explicitly link a native recipe; optional/dlopen hosts import
// avif/bridge alone and supply its function table.
Interop :: #import "bridge";
#import "static"
#import "static_encode"
StaticNativeAPI :: () -> Interop.AvifAPI { return StaticAPI() }
using Encoding :: #import "encode"
using Preview :: #import "preview"
EncodeRGBA8 :: (source: RgbaView, metadata: EncodeMetadata, options: EncodeOptions) -> EncodeResult {
    return EncodeRGBA8WithAPI(StaticEncodeAPI(), source, metadata, options)
}
StaticNativeEncodeAPI :: () -> AvifEncodeAPI { return StaticEncodeAPI() }
Reencode :: (input: BorrowedBytes, options: EncodeOptions) -> EncodeResult {
    return ReencodeWithAPI(StaticAPI(), StaticEncodeAPI(), input, options)
}
