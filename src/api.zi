using Engine :: #import "engine"
#import "libaom"
#import "dav1d"
// First complete frame, owned std/image.Image with straight RGBA8 pixels.
Decode :: (input: BorrowedBytes, options: DecodeOptions) -> DecodeResult {
    return DecodeWithEngine(LibaomEngine(), input, *options)
}

DefaultEngine :: () -> Av1Engine { return LibaomEngine() }
Dav1dOracle :: () -> Av1Engine { return Dav1dEngine() }
// Static hosts explicitly link a native recipe; optional/dlopen hosts import
// avif/bridge alone and supply its function table.
Interop :: #import "bridge";
#import "static"
StaticNativeAPI :: () -> Interop.AvifAPI { return StaticAPI() }
