// Fast 8-bit YUV to straight RGBA8 for the native decoder. Built without
// libyuv, libavif converts subsampled chroma in a generic loop that tests its
// format, depth and mode for every pixel, most of a phone's AVIF decode. This
// repeats that loop's float arithmetic for 8-bit 4:2:0 and 4:2:2 in the same
// order, so every byte equals libavif's (and the reference decoder's), and
// splits the rows across the cores. Anything else returns false for libavif.

FastRGBAPlanes :: struct {
    y: *u8; u: *u8; v: *u8; alpha: *u8
    y_row: s64; u_row: s64; v_row: s64; alpha_row: s64
    width: s32; height: s32; subsampled_rows: bool
    // libavif's lookup tables, ((sample - bias) / range), and coefficients.
    luma: [256]float32; chroma: [256]float32
    kr: float32; kb: float32; kg: float32
    output: *u8; output_row: s64
}

#if #defined(POSIX_THREADS) {
    FastWorkers :: #import "std/parallel_linux";
}

// Straight RGBA8 from 8-bit planes. MATRIX is the image's CICP matrix,
// FORMAT libavif's pixel format (2 422, 3 420; 1 444 has libavif's own fast
// path) and FULL its range.
FastRGBA8 :: (y: *u8, y_row: s64, u: *u8, u_row: s64, v: *u8, v_row: s64,
    alpha: *u8, alpha_row: s64, width: s32, height: s32, format: s32, matrix: s32,
    full: bool, output: *u8, output_row: s64) -> bool {
    if y == null || u == null || v == null || output == null || width <= 0 || height <= 0 { return false }
    if format != 2 && format != 3 { return false }
    planes: FastRGBAPlanes
    // libavif's matrix table; unspecified (2) keeps its BT.601 default.
    planes.kr = 0.299; planes.kb = 0.114
    if matrix == 1 { planes.kr = 0.2126; planes.kb = 0.0722 }
    else if matrix == 4 { planes.kr = 0.30; planes.kb = 0.11 }
    else if matrix == 7 { planes.kr = 0.212; planes.kb = 0.087 }
    else if matrix == 9 { planes.kr = 0.2627; planes.kb = 0.0593 }
    else if matrix != 2 && matrix != 5 && matrix != 6 { return false }
    one: float32 = 1.0
    planes.kg = one - planes.kr - planes.kb
    bias_y: float32 = ifx full then 0.0 else 16.0
    range_y: float32 = ifx full then 255.0 else 219.0
    bias_c: float32 = 128.0
    range_c: float32 = ifx full then 255.0 else 224.0
    for sample: 0..255 {
        planes.luma[sample] = (cast(float32)sample - bias_y) / range_y
        planes.chroma[sample] = (cast(float32)sample - bias_c) / range_c
    }
    planes.y = y; planes.u = u; planes.v = v; planes.alpha = alpha
    planes.y_row = y_row; planes.u_row = u_row; planes.v_row = v_row; planes.alpha_row = alpha_row
    planes.width = width; planes.height = height; planes.subsampled_rows = format == 3
    planes.output = output; planes.output_row = output_row
    #if #defined(POSIX_THREADS) {
        // A pool per image: decodes on different threads never share one.
        if cast(s64)width * height >= 65536 {
            workers: FastWorkers.ParallelPool
            callback: FastWorkers.RangeProcedure = FastRGBARows
            FastWorkers.ParallelRun(*workers, 0, cast(s64)height, callback, cast(*void)*planes)
            FastWorkers.ParallelClose(*workers)
            return true
        }
    }
    FastRGBARows(0, cast(s64)height, cast(*void)*planes)
    return true
}

// libavif's store: clamp to 0..1, then (uint8_t)(0.5f + value * 255.0f).
FastRGBAByte :: (value: float32) -> u8 {
    clamped: float32 = ifx value < 0.0 then 0.0 else ifx value > 1.0 then 1.0 else value
    half: float32 = 0.5
    scale: float32 = 255.0
    return cast(u8)cast(s32)(half + clamped * scale)
}

// Rows [START, END). Each pixel's chroma is libavif's bilinear sum of its own
// sample and the samples across its nearer column, row and diagonal, with the
// weights 9/16, 3/16, 3/16 and 1/16 added in that order.
FastRGBARows :: (start: s64, end: s64, argument: *void) {
    p := cast(*FastRGBAPlanes)argument
    own: float32 = 0.5625; across: float32 = 0.1875; diagonal: float32 = 0.0625
    one: float32 = 1.0; two: float32 = 2.0
    red_v: float32 = two * (one - p.kr)
    blue_u: float32 = two * (one - p.kb)
    green_r: float32 = p.kr * (one - p.kr)
    green_b: float32 = p.kb * (one - p.kb)
    last_x := p.width - 1
    for row: start..end-1 {
        j := cast(s32)row
        cy := ifx p.subsampled_rows then j >> 1 else j
        // libavif's rows: 4:2:2, the first row and an odd last row repeat
        // their own sample; odd rows look down, even rows up.
        u_next: s64 = 0; v_next: s64 = 0
        if p.subsampled_rows && j != 0 && !(j == p.height - 1 && (j & 1) != 0) {
            u_next = ifx (j & 1) != 0 then p.u_row else -p.u_row
            v_next = ifx (j & 1) != 0 then p.v_row else -p.v_row
        }
        u_base := cast(s64)cy * p.u_row
        v_base := cast(s64)cy * p.v_row
        luma := row * p.y_row
        alpha := row * p.alpha_row
        out := row * p.output_row
        for x: cast(s32)0..last_x {
            cx := cast(s64)(x >> 1)
            side: s64 = 0
            if x != 0 && !(x == last_x && (x & 1) != 0) { side = ifx (x & 1) != 0 then 1 else -1 }
            u := u_base + cx
            v := v_base + cx
            cb := p.chroma[p.u[u]] * own + p.chroma[p.u[u + side]] * across +
                p.chroma[p.u[u + u_next]] * across + p.chroma[p.u[u + side + u_next]] * diagonal
            cr := p.chroma[p.v[v]] * own + p.chroma[p.v[v + side]] * across +
                p.chroma[p.v[v + v_next]] * across + p.chroma[p.v[v + side + v_next]] * diagonal
            level := p.luma[p.y[luma + x]]
            red := level + red_v * cr
            blue := level + blue_u * cb
            green := level - (two * (green_r * cr + green_b * cb)) / p.kg
            at := out + cast(s64)x * 4
            p.output[at] = FastRGBAByte(red)
            p.output[at + 1] = FastRGBAByte(green)
            p.output[at + 2] = FastRGBAByte(blue)
            p.output[at + 3] = ifx p.alpha != null then p.alpha[alpha + x] else cast(u8)255
        }
    }
}
