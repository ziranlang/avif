#import, file "../src/av1/directional.zi";
using Codec :: #import "image_codec/api"

DirectionalBoundaries :: () -> s32 {
    above: [8]u16; left: [8]u16
    if PredictDirectional4x4(above[:7], left[:], 0, true, true, 1, 0, true, 0, 8).error.code != InvalidInput { return 1 }
    if PredictDirectional4x4(above[:], left[:7], 0, true, true, 1, 0, true, 0, 8).error.code != InvalidInput { return 2 }
    if PredictDirectional4x4(above[:], left[:], 0, true, true, 0, 0, true, 0, 8).error.code != InvalidInput { return 3 }
    if PredictDirectional4x4(above[:], left[:], 0, true, true, 9, 0, true, 0, 8).error.code != InvalidInput { return 4 }
    if PredictDirectional4x4(above[:], left[:], 0, true, true, 1, -4, true, 0, 8).error.code != InvalidInput { return 5 }
    if PredictDirectional4x4(above[:], left[:], 0, true, true, 1, 4, true, 0, 8).error.code != InvalidInput { return 6 }
    if PredictDirectional4x4(above[:], left[:], 0, true, true, 1, 0, true, 2, 8).error.code != InvalidInput { return 7 }
    if PredictDirectional4x4(above[:], left[:], 0, true, true, 1, 0, true, 0, 16).error.code != InvalidInput { return 8 }
    if PredictDirectional4x4(above[:], left[:], 256, true, true, 1, 0, true, 0, 8).error.code != InvalidInput { return 9 }
    above[7] = 256
    invalid := PredictDirectional4x4(above[:], left[:], 0, true, true, 1, 0, true, 0, 8)
    if invalid.error.code != InvalidInput { return 10 }
    for i: 0..15 { if invalid.samples[i] != 0 { return 11 } }
    above[7] = 0; left[7] = 65535
    if PredictDirectional4x4(above[:], left[:], 0, true, true, 1, 0, true, 0, 12).error.code != InvalidInput { return 12 }
    left[7] = 0
    token: Cancellation; Cancel(*token)
    cancelled := PredictDirectional4x4(above[:], left[:], 0, true, true, 1, 0, true, 0, 8, *token)
    if cancelled.error.code != DecodeCancelled { return 13 }
    for i: 0..15 { if cancelled.samples[i] != 0 { return 14 } }
    if DirectionalFloor(-1, 64) != -1 || DirectionalFloor(-64, 64) != -1 || DirectionalFloor(-65, 64) != -2 { return 15 }
    return 0
}
