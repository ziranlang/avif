#import, file "../src/av1/entropy.zi";
#import, file "../src/av1/coefficients.zi";
#import, file "../src/av1/cdfs4.zi";
#import, file "../src/av1/range.zi";
using Codec :: #import "image_codec/api"

// Arbitrary entropy fuzzes bounded rejection/determinism, not conformance.
CoefficientBoundaries :: () -> s32 {
    bytes: [32]u8
    decoder := NewRange(BorrowBytes(bytes[:]), 0, 32)
    cdfs := NewCoeffCDF4x4()
    if ReadLosslessCoefficients4x4(null, *cdfs, 0, 0).error.code != InvalidInput { return 1 }
    if ReadLosslessCoefficients4x4(*decoder, null, 0, 0).error.code != InvalidInput { return 2 }
    if ReadLosslessCoefficients4x4(*decoder, *cdfs, -1, 0).error.code != InvalidInput { return 3 }
    if ReadLosslessCoefficients4x4(*decoder, *cdfs, 7, 0).error.code != InvalidInput { return 4 }
    if ReadLosslessCoefficients4x4(*decoder, *cdfs, 0, -1).error.code != InvalidInput { return 5 }
    if ReadLosslessCoefficients4x4(*decoder, *cdfs, 0, 3).error.code != InvalidInput { return 6 }
    token: Cancellation; Cancel(*token)
    if ReadLosslessCoefficients4x4(*decoder, *cdfs, 0, 0, *token).error.code != DecodeCancelled { return 7 }
    if DecodeLosslessStill(BorrowBytes(bytes[:]), 0, 32, 8, 8, 8, false, *token).error.code != DecodeCancelled { return 8 }
    state: u32 = 4270181
    depths: [3]s32 = .[8,10,12]
    for test: 0..511 {
        for i: 0..31 {
            state = state * 1664525 + 1013904223
            bytes[i] = cast(u8)(state >> 24)
        }
        size := test % 32 + 1
        depth := depths[test % 3]
        first := DecodeLosslessStill(BorrowBytes(bytes[:]), 0, size, depth, 8, 8, false)
        second := DecodeLosslessStill(BorrowBytes(bytes[:]), 0, size, depth, 8, 8, false)
        if first.error.code != second.error.code || first.error.offset != second.error.offset { return 9 }
        if first.error.code == DecodeOK {
            maximum := cast(u32)1 << cast(u32)depth
            for i: 0..63 {
                if first.samples[i] != second.samples[i] || first.samples[i] >= maximum { return 10 }
            }
        }
    }
    return 0
}
