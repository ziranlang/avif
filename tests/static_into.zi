#import "api"
#import "bridge_cases"
#import "std/byte_text_linux"
#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    if argc != 2 { return 2 }
    api := StaticNativeAPI()
    directory := TextFromCString(argv[1])
    names: [17]string = .["rgba8", "rgba10", "rgba12", "gray8", "gray10", "gray12", "transform00", "transform01", "transform10", "transform11", "transform20", "transform21", "transform30", "transform31", "premultiplied", "opaque", "animated"]
    for name: names {
        code := CheckBridgeCase(api, directory, name)
        if code != 0 { print("% dynamic case failed %\n", name, code); return code }
    }
    print("Static table bridge:17 owned/probe/padded outputs, errors and ABI handshake passed\n")
    return 0
}
