#import "color"
#import "grid"
#import "output"
#import "color_cases"
#program_export
CheckColor :: (case: *ColorCase, index: s64) -> s32 {
    bytes: s32 = ifx case.depth == 8 then 1 else 2
    cw := (7 + case.sx) >> case.sx; ch := (5 + case.sy) >> case.sy
    source: PlanarImage
    source.color = ColorSpec.{case.depth,case.full != 0,case.matrix,case.sx,case.sy,case.mono != 0,case.filter,1}
    source.y = PlaneView.{7,5,cast(s64)(7 * bytes + 3),bytes,case.y[:]}
    source.u = PlaneView.{cw,ch,cast(s64)(cw * bytes + 3),bytes,case.u[:]}
    source.v = PlaneView.{cw,ch,cast(s64)(cw * bytes + 3),bytes,case.v[:]}
    source.alpha = PlaneView.{7,5,cast(s64)(7 * bytes + 3),bytes,case.alpha[:]}
    source.has_alpha = case.alpha_mode != 0; source.source_premultiplied = case.alpha_mode == 2
    storage: [192]u8
    for i: 0..191 { storage[i] = 77 }
    options := DefaultOptions(); budget := NewWorkerBudget(options.limits); options.workers = *budget
    output := OutputBuffer.{storage[:160],33}
    result := ConvertRGBA8Into(source, output, options)
    if !result.is_ok || !result.output_may_be_modified || budget.active_workers != 0 || budget.working_bytes != 0 { print("color case % error %\n", index, result.error.code); return 1 }
    for y: 0..4 {
        for x: 0..27 {
            if storage[y * 33 + x] != case.expected[y * 28 + x] {
                print("color case % pixel %,% got % expected %\n", index, x, y, storage[y * 33 + x], case.expected[y * 28 + x]); return 2
            }
        }
        for x: 28..32 { if storage[y * 33 + x] != 77 { return 3 }
    }
    }
    for i: 160..191 { if storage[i] != 77 { return 4 }
    }
    return 0
}
CheckInvalidColor :: () -> s32 {
    ranges: [16]u8
    if ByteRangesOverlap(ranges[:4], ranges[4:8]) || ByteRangesOverlap(ranges[:0], ranges[:]) { return 9 }
    if !ByteRangesOverlap(ranges[:8], ranges[4:12]) || !ByteRangesOverlap(ranges[4:12], ranges[:8]) ||
       !ByteRangesOverlap(ranges[:], ranges[4:8]) { return 9 }
    y: [8]u8 = .[128,128,128,128,128,128,128,128]
    u: [8]u8 = .[128,128,128,128,128,128,128,128]
    v: [8]u8 = .[128,128,128,128,128,128,128,128]
    storage: [16]u8
    for i: 0..15 { storage[i] = 77 }
    source: PlanarImage
    source.color = ColorSpec.{8,true,1,0,0,false,NearestChroma,1}
    source.y = PlaneView.{2,1,2,1,y[:]}; source.u = PlaneView.{2,1,2,1,u[:]}; source.v = PlaneView.{2,1,2,1,v[:]}
    output := OutputBuffer.{storage[:],8}; options := DefaultOptions()
    source.color.matrix = 14
    unsupported := ConvertRGBA8Into(source, output, options)
    if unsupported.error.code != UnsupportedCapability || unsupported.output_may_be_modified { return 10 }
    source.color.matrix = 1; source.color.transfer_characteristics = 16
    hdr := ConvertRGBA8Into(source, output, options)
    if hdr.error.code != UnsupportedCapability || hdr.output_may_be_modified { return 10 }
    source.color.transfer_characteristics = 1; source.u.data = u[:1]
    short := ConvertRGBA8Into(source, output, options)
    if short.error.code != OutputTooSmall || short.output_may_be_modified { return 11 }
    source.u.data = u[:]; source.u.width = 1
    wrong := ConvertRGBA8Into(source, output, options)
    if wrong.error.code != InvalidInput || wrong.output_may_be_modified { return 12 }
    source.u.width = 2; source.color.depth = 10
    source.y.sample_bytes = 2; source.u.sample_bytes = 2; source.v.sample_bytes = 2
    source.y.stride = 4; source.u.stride = 4; source.v.stride = 4
    bad_sample := ConvertRGBA8Into(source, output, options)
    if bad_sample.error.code != MalformedInput || bad_sample.output_may_be_modified { return 13 }
    source.color.depth = 8
    source.y.sample_bytes = 1; source.u.sample_bytes = 1; source.v.sample_bytes = 1
    source.y.stride = 2; source.u.stride = 2; source.v.stride = 2
    source.source_premultiplied = true
    alpha := ConvertRGBA8Into(source, output, options)
    if alpha.error.code != InvalidInput || alpha.output_may_be_modified { return 14 }
    source.source_premultiplied = false; output.data = storage[:7]
    capacity := ConvertRGBA8Into(source, output, options)
    if capacity.error.code != OutputTooSmall || capacity.output_may_be_modified { return 15 }
    output.data = storage[:]; token: Cancellation; token.requested = true; options.cancellation = *token
    cancelled := ConvertRGBA8Into(source, output, options)
    if cancelled.error.code != DecodeCancelled || cancelled.output_may_be_modified { return 16 }
    token.requested = false; budget := NewWorkerBudget(options.limits); budget.active_workers = 1; options.workers = *budget
    busy := ConvertRGBA8Into(source, output, options)
    if busy.error.code != WorkerBudgetExceeded || busy.output_may_be_modified || budget.active_workers != 1 { return 17 }
    options.workers = null
    options.limits.max_working_bytes = 1
    limited := ConvertRGBA8Into(source, output, options)
    if limited.error.code != LimitExceeded || limited.output_may_be_modified { return 18 }
    options.limits.max_working_bytes = 536870912
    alias := ConvertRGBA8Into(source, OutputBuffer.{y[:],8}, options)
    if alias.error.code != InvalidInput || alias.output_may_be_modified { return 18 }
    for i: 0..15 { if storage[i] != 77 { return 19 }
    }
    return 0
}
CheckTransforms :: () -> s32 {
    storage: [64]u8
    source: [64]u8
    for y: 0..2 { for x: 0..3 {
        at := y * 19 + x * 4
        source[at] = cast(u8)(y * 4 + x + 1); source[at + 1] = 0; source[at + 2] = 0; source[at + 3] = 255
    }
    }
    expected: [24]u8 = .[6,7,8,10,11,12,8,12,7,11,6,10,12,11,10,8,7,6,10,6,11,7,12,8]
    view := RgbaView.{4,3,19,source[:]}; options := DefaultOptions()
    for angle: cast(s32)0..3 { for mirror: cast(s32)-1..1 {
        width: s32 = ifx (angle & 1) == 0 then 3 else 2
        height: s32 = ifx (angle & 1) == 0 then 2 else 3
        stride := cast(s64)width * 4 + 5
        for i: 0..63 { storage[i] = 77 }
        result := TransformRGBA8Into(view, OutputTransform.{1,1,3,2,angle,mirror}, OutputBuffer.{storage[:],stride}, options)
        if !result.is_ok || !result.output_may_be_modified { return 20 }
        for y: 0..height - 1 { for x: 0..width - 1 {
            sx := ifx mirror == 1 then width - 1 - x else x
            sy := ifx mirror == 0 then height - 1 - y else y
            at := cast(s64)y * stride + x * 4
            if storage[at] != expected[angle * 6 + sy * width + sx] || storage[at + 1] != 0 || storage[at + 2] != 0 || storage[at + 3] != 255 { return 21 }
        }
        for pad: cast(s64)width * 4..stride - 1 { if storage[y * stride + pad] != 77 { return 22 }
        }
    }
    }
    }
    crop := TransformRGBA8Into(view, OutputTransform.{3,1,3,2,0,-1}, OutputBuffer.{storage[:],17}, options)
    if crop.error.code != InvalidInput || crop.output_may_be_modified { return 23 }
    orientation := TransformRGBA8Into(view, OutputTransform.{1,1,3,2,4,-1}, OutputBuffer.{storage[:],17}, options)
    if orientation.error.code != InvalidInput || orientation.output_may_be_modified { return 23 }
    mirror := TransformRGBA8Into(view, OutputTransform.{1,1,3,2,0,2}, OutputBuffer.{storage[:],17}, options)
    if mirror.error.code != InvalidInput || mirror.output_may_be_modified { return 23 }
    short := TransformRGBA8Into(view, OutputTransform.{1,1,3,2,0,-1}, OutputBuffer.{storage[:1],17}, options)
    if short.error.code != OutputTooSmall || short.output_may_be_modified { return 24 }
    alias := TransformRGBA8Into(view, OutputTransform.{1,1,3,2,0,-1}, OutputBuffer.{source[:],17}, options)
    if alias.error.code != InvalidInput || alias.output_may_be_modified { return 25 }
    token: Cancellation; token.requested = true; options.cancellation = *token
    cancelled := TransformRGBA8Into(view, OutputTransform.{1,1,3,2,0,-1}, OutputBuffer.{storage[:],17}, options)
    if cancelled.error.code != DecodeCancelled || cancelled.output_may_be_modified { return 26 }
    return 0
}
CheckGrid :: () -> s32 {
    a: [22]u8; b: [22]u8; c: [22]u8; d: [22]u8
    views: [4]RgbaView = .[RgbaView.{2,2,11,a[:]},RgbaView.{2,2,11,b[:]},RgbaView.{2,2,11,c[:]},RgbaView.{2,2,11,d[:]}]
    labels: [16]u8 = .[1,2,4,5,3,99,6,99,7,8,99,99,9,99,99,99]
    for tile: 0..3 { for y: 0..1 { for x: 0..1 {
        at := y * 11 + x * 4
        views[tile].data[at] = labels[tile * 4 + y * 2 + x]
        views[tile].data[at + 3] = 255
    }
        }
    }
    storage: [64]u8; for i: 0..63 { storage[i] = 77 }
    layout := GridLayout.{2,2,3,3,2,2}; output := OutputBuffer.{storage[:46],17}; options := DefaultOptions()
    result := ComposeGridRGBA8Into(views[:], layout, output, options)
    if !result.is_ok || !result.output_may_be_modified { return 30 }
    for y: 0..2 { for x: 0..2 {
        at := y * 17 + x * 4
        if storage[at] != cast(u8)(y * 3 + x + 1) || storage[at + 1] != 0 || storage[at + 2] != 0 || storage[at + 3] != 255 { return 31 }
    }
        for pad: 12..16 { if storage[y * 17 + pad] != 77 { return 32 }
        }
    }
    for i: 46..63 { if storage[i] != 77 { return 33 }
    }
    count := ComposeGridRGBA8Into(views[:3], layout, output, options)
    if count.error.code != InvalidInput || count.output_may_be_modified { return 34 }
    views[3].width = 1
    shape := ComposeGridRGBA8Into(views[:], layout, output, options)
    if shape.error.code != InvalidInput || shape.output_may_be_modified { return 35 }
    views[3].width = 2; layout.width = 2
    empty := ComposeGridRGBA8Into(views[:], layout, output, options)
    if empty.error.code != InvalidInput || empty.output_may_be_modified { return 36 }
    layout.width = 3; output.data = storage[:45]
    short := ComposeGridRGBA8Into(views[:], layout, output, options)
    if short.error.code != OutputTooSmall || short.output_may_be_modified { return 37 }
    alias := ComposeGridRGBA8Into(views[:1], GridLayout.{1,1,2,2,2,2}, OutputBuffer.{a[:],11}, options)
    if alias.error.code != InvalidInput || alias.output_may_be_modified { return 38 }
    token: Cancellation; token.requested = true; options.cancellation = *token
    cancelled := ComposeGridRGBA8Into(views[:], layout, output, options)
    if cancelled.error.code != DecodeCancelled || cancelled.output_may_be_modified { return 39 }
    return 0
}
main :: () -> s32 {
    for i: 0..COLOR_CASE_COUNT - 1 {
        fixture := GetColorCase(i)
        code := CheckColor(*fixture, i)
        if code != 0 { return code }
    }
    code := CheckInvalidColor(); if code != 0 { return code }
    code = CheckTransforms(); if code != 0 { return code }
    code = CheckGrid(); if code != 0 { return code }
    print("Authored planar output: % pinned color cases, alpha, padded crop/orientation, clipped grids and rejection contracts passed\n", COLOR_CASE_COUNT)
    return 0
}
