#import, file "../src/av1/reconstruct.zi";

#program_export
main :: () -> s32 {
    plane: Plane
    plane.width = 8; plane.height = 8
    depths: [3]s32 = .[8,10,12]
    for d: 0..2 {
        depth := depths[d]
        sample: s32 = ifx depth == 8 then 1 else 2
        plane.stride = 8 * sample + 3; plane.sample_bytes = sample
        if !VecResize(plane.storage, plane.stride * 8) { return 1 }
        for i: 0..plane.storage.count - 1 { plane.storage[i] = 77 }
        error := ReconstructZeroDC8x8(*plane, depth)
        if error.code != DecodeOK { return 2 }
        midpoint := cast(u32)1 << cast(u32)(depth - 1)
        for row: 0..7 {
            for column: 0..7 {
                at := row * plane.stride + column * sample
                if plane.storage[at] != cast(u8)(midpoint & 255) { return 3 }
                if sample == 2 && plane.storage[at + 1] != cast(u8)(midpoint >> 8) { return 4 }
            }
            for padding: cast(s64)8 * sample..plane.stride - 1 {
                if plane.storage[row * plane.stride + padding] != 77 { return 5 }
            }
        }
    }
    if !VecResize(plane.storage, 148) { return 6 }
    for i: 0..147 { plane.storage[i] = 77 }
    short := ReconstructZeroDC8x8(*plane, 12)
    if short.code != OutputTooSmall { return 7 }
    for i: 0..147 { if plane.storage[i] != 77 { return 8 } }
    if !VecResize(plane.storage, 152) { return 9 }
    token: Cancellation; Cancel(*token)
    cancelled := ReconstructZeroDC8x8(*plane, 12, *token)
    if cancelled.code != DecodeCancelled || plane.storage[0] != 77 { return 10 }
    if ReconstructZeroDC8x8(*plane, 16).code != InvalidInput || ReconstructZeroDC8x8(null, 8).code != InvalidInput { return 11 }
    plane.stride = 9223372036854775807
    if ReconstructZeroDC8x8(*plane, 12).code == DecodeOK { return 12 }
    return 0
}
