#import, file "../src/av1/intra_predict.zi";
#import, file "../src/av1/cfl.zi";

IntraTestStride :: 144

// Deterministic neighbor sample shared with the oracle host.
IntraTestSample :: (seed: s64, style: s64, depth: s64, row: s64, column: s64) -> u16 {
    maximum := (cast(s64)1 << cast(u32)depth) - 1
    k := (seed * 40009 + row * 263 + column * 7919 + 17) % 2147483648
    k = (k * 1103515245 + 12345) % 2147483648
    k = (k * 1103515245 + 12345) % 2147483648
    noise := k >> 4
    if style == 0 { return cast(u16)(noise % (maximum + 1)) }
    if style == 1 {
        scale := cast(s64)1 << cast(u32)(depth - 8)
        value := (cast(s64)1 << cast(u32)(depth - 1)) + ((row * 3 + column * 5) % 64 - 32) * scale + noise % (4 * scale) - 2 * scale
        if value < 0 { value = 0 }
        if value > maximum { value = maximum }
        return cast(u16)value
    }
    return cast(u16)(ifx noise % 2 == 0 then 0 else maximum)
}

// Fills (value 1) or clears (value 0) the neighbor row and column a case reads.
IntraTestNeighbors :: (plane: []u16, c: []s32, fill: bool) {
    x := cast(s64)c[2]; y := cast(s64)c[3]; max_x := cast(s64)c[4]; max_y := cast(s64)c[5]
    seed := cast(s64)c[16]; style := cast(s64)c[17]; depth := cast(s64)c[15]
    if y > 0 {
        first := ifx x > 0 then x - 1 else x
        for column: first..max_x {
            plane[(y - 1) * IntraTestStride + column] = ifx fill then IntraTestSample(seed, style, depth, y - 1, column) else 0
        }
    }
    if x > 0 {
        first := ifx y > 0 then y - 1 else y
        for row: first..max_y {
            plane[row * IntraTestStride + x - 1] = ifx fill then IntraTestSample(seed, style, depth, row, x - 1) else 0
        }
    }
}

// Case fields: width height x y max_x max_y have_above have_left
// have_above_right have_below_left mode angle_delta filter_mode edge_filter
// filter_type depth seed style hash1 hash2. Output uses stride width+1 so
// every case also proves the gap column is untouched.
RunIntraCase :: (c: []s32, plane: []u16, out: []u16) -> s32 {
    w := c[0]; h := c[1]; stride := w + 1
    used := cast(s64)(h - 1) * stride + w
    for i: 0..used - 1 { out[i] = 65535 }
    IntraTestNeighbors(plane, c, true)
    edges: IntraEdges
    error := BuildIntraEdges(*edges, plane, IntraTestStride, c[2], c[3], w, h, c[4], c[5],
        c[6] != 0, c[7] != 0, c[8] != 0, c[9] != 0, c[15])
    IntraTestNeighbors(plane, c, false)
    if error.code != DecodeOK { return 1 }
    if PredictIntra(out[:used], stride, *edges, c[10], c[11], c[12], c[13] != 0, c[14]).code != DecodeOK { return 2 }
    hash1: s64; hash2: s64
    for i: 0..cast(s64)h - 1 {
        for j: 0..cast(s64)w - 1 {
            value := cast(s64)out[i * stride + j]
            hash1 = (hash1 * 31 + value + 1) % 2147483647
            hash2 = (hash2 * 1000003 + value * 7 + 3) % 2147483629
        }
        if i < h - 1 && out[i * stride + w] != 65535 { return 3 }
    }
    if hash1 != cast(s64)c[18] || hash2 != cast(s64)c[19] { return 4 }
    return 0
}

// Every directional size/angle/filter combination with full availability:
// edge, upsample and base indices depend only on these, so this sweep covers
// each reachable index range (checked by the sanitizer build).
IntraIndexSweep :: () -> s32 {
    widths: [19]s32 = .[4,8,16,32,64,4,8,8,16,16,32,32,64,4,16,8,32,16,64]
    heights: [19]s32 = .[4,8,16,32,64,8,4,16,8,32,16,64,32,16,4,32,8,64,16]
    out: [4096]u16
    for size: 0..18 {
        w := widths[size]; h := heights[size]
        for depth_index: 0..1 {
            depth: s32 = ifx depth_index == 0 then 8 else 12
            maximum := cast(s32)((cast(u32)1 << cast(u32)depth) - 1)
            edges: IntraEdges
            for i: -1..cast(s64)(w + h) - 1 {
                edges.above[IntraEdgeOffset + i] = ifx i % 3 == 0 then maximum else 0
                edges.left[IntraEdgeOffset + i] = ifx i % 2 == 0 then 0 else maximum
            }
            edges.left[IntraEdgeOffset - 1] = edges.above[IntraEdgeOffset - 1]
            edges.width = w; edges.height = h; edges.available_width = w; edges.available_height = h
            edges.have_above = true; edges.have_left = true; edges.bit_depth = depth
            for mode: 1..8 { for delta: -3..3 { for variant: 0..3 {
                filter := variant & 1; enabled := variant >= 2
                if PredictIntra(out[:], w, *edges, cast(s32)mode, cast(s32)delta, -1, enabled, cast(s32)filter).code != DecodeOK { return 1 }
                for i: 0..cast(s64)w * h - 1 { if out[i] > maximum { return 2 } }
            } } }
            for mode: 0..12 {
                if PredictIntra(out[:], w, *edges, cast(s32)mode, 0, -1, true, 0).code != DecodeOK { return 3 }
            }
            if w <= 32 && h <= 32 {
                for filter_mode: 0..4 {
                    if PredictIntra(out[:], w, *edges, 0, 0, cast(s32)filter_mode, true, 0).code != DecodeOK { return 4 }
                }
            }
        }
    }
    return 0
}

IntraPredictBoundaries :: () -> s32 {
    plane: [256]u16
    for i: 0..255 { plane[i] = cast(u16)(i * 3) }
    edges: IntraEdges
    if BuildIntraEdges(null, plane[:], 16, 4, 4, 4, 4, 15, 15, true, true, false, false, 10).code != InvalidInput { return 1 }
    if BuildIntraEdges(*edges, plane[:], 16, 4, 4, 2, 4, 15, 15, true, true, false, false, 10).code != InvalidInput { return 2 }
    if BuildIntraEdges(*edges, plane[:], 16, 4, 4, 4, 32, 15, 15, true, true, false, false, 10).code != InvalidInput { return 3 }
    if BuildIntraEdges(*edges, plane[:], 16, 4, 4, 4, 4, 15, 15, true, true, false, false, 9).code != InvalidInput { return 4 }
    if BuildIntraEdges(*edges, plane[:], 0, 4, 4, 4, 4, 15, 15, true, true, false, false, 10).code != InvalidInput { return 5 }
    if BuildIntraEdges(*edges, plane[:], 16, 4, 4, 4, 4, 16, 15, true, true, false, false, 10).code != InvalidInput { return 6 }
    if BuildIntraEdges(*edges, plane[:], 16, 12, 4, 4, 4, 11, 15, true, true, false, false, 10).code != InvalidInput { return 7 }
    if BuildIntraEdges(*edges, plane[:], 16, 4, 0, 4, 4, 15, 15, true, false, false, false, 10).code != InvalidInput { return 8 }
    if BuildIntraEdges(*edges, plane[:], 16, 0, 4, 4, 4, 15, 15, false, true, false, false, 10).code != InvalidInput { return 9 }
    if BuildIntraEdges(*edges, plane[:255], 16, 4, 4, 4, 4, 15, 15, true, true, false, false, 10).code != InvalidInput { return 10 }
    // 8-bit samples above 255 are rejected and leave edges unchanged.
    if BuildIntraEdges(*edges, plane[:], 16, 4, 4, 4, 4, 15, 15, true, true, false, false, 8).code != InvalidInput { return 11 }
    if edges.width != 0 { return 12 }
    // Edge construction: limits, replication and missing-side defaults.
    if BuildIntraEdges(*edges, plane[:], 16, 13, 4, 4, 4, 14, 15, true, true, true, false, 10).code != DecodeOK { return 13 }
    if edges.available_width != 2 || edges.available_height != 4 { return 14 }
    if edges.above[IntraEdgeOffset - 1] != 3 * 60 || edges.left[IntraEdgeOffset - 1] != 3 * 60 { return 15 }
    if edges.above[IntraEdgeOffset] != 3 * 61 || edges.above[IntraEdgeOffset + 1] != 3 * 62 || edges.above[IntraEdgeOffset + 7] != 3 * 62 { return 16 }
    if edges.left[IntraEdgeOffset] != 3 * 76 || edges.left[IntraEdgeOffset + 3] != 3 * 124 || edges.left[IntraEdgeOffset + 7] != 3 * 124 { return 17 }
    if BuildIntraEdges(*edges, plane[:], 16, 4, 4, 4, 4, 15, 15, false, false, false, false, 10).code != DecodeOK { return 18 }
    if edges.above[IntraEdgeOffset + 5] != 511 || edges.left[IntraEdgeOffset + 5] != 513 || edges.above[IntraEdgeOffset - 1] != 512 { return 19 }
    if BuildIntraEdges(*edges, plane[:], 16, 4, 4, 4, 4, 15, 15, false, true, false, false, 10).code != DecodeOK { return 20 }
    if edges.above[IntraEdgeOffset + 6] != 3 * 67 || edges.above[IntraEdgeOffset - 1] != 3 * 67 { return 21 }
    if BuildIntraEdges(*edges, plane[:], 16, 4, 4, 4, 4, 15, 15, true, false, false, false, 10).code != DecodeOK { return 22 }
    if edges.left[IntraEdgeOffset + 6] != 3 * 52 || edges.above[IntraEdgeOffset - 1] != 3 * 52 { return 23 }
    // Prediction contracts: nothing is written on failure.
    if BuildIntraEdges(*edges, plane[:], 16, 4, 4, 8, 8, 15, 15, true, true, false, false, 10).code != DecodeOK { return 24 }
    out: [100]u16
    for i: 0..99 { out[i] = 7 }
    if PredictIntra(out[:], 8, null, 0, 0, -1, true, 0).code != InvalidInput { return 25 }
    if PredictIntra(out[:], 8, *edges, 13, 0, -1, true, 0).code != InvalidInput { return 26 }
    if PredictIntra(out[:], 8, *edges, 3, 4, -1, true, 0).code != InvalidInput { return 27 }
    if PredictIntra(out[:], 8, *edges, 0, 0, 5, true, 0).code != InvalidInput { return 28 }
    if PredictIntra(out[:], 8, *edges, 1, 0, 0, true, 0).code != InvalidInput { return 29 }
    if PredictIntra(out[:], 8, *edges, 0, 0, -1, true, 2).code != InvalidInput { return 30 }
    if PredictIntra(out[:], 7, *edges, 0, 0, -1, true, 0).code != InvalidInput { return 31 }
    if PredictIntra(out[:63], 8, *edges, 0, 0, -1, true, 0).code != InvalidInput { return 32 }
    token: Cancellation; Cancel(*token)
    if PredictIntra(out[:], 8, *edges, 0, 0, -1, true, 0, *token).code != DecodeCancelled { return 33 }
    saved := edges.above[IntraEdgeOffset + 3]
    edges.above[IntraEdgeOffset + 3] = 1024
    if PredictIntra(out[:], 8, *edges, 0, 0, -1, true, 0).code != InvalidInput { return 34 }
    edges.above[IntraEdgeOffset + 3] = saved
    edges.left[IntraEdgeOffset - 1] += 1
    if PredictIntra(out[:], 8, *edges, 0, 0, -1, true, 0).code != InvalidInput { return 35 }
    edges.left[IntraEdgeOffset - 1] -= 1
    for i: 0..99 { if out[i] != 7 { return 36 } }
    // Blocks may extend past the decoded area; filter intra is limited to
    // 32x32; DC without neighbors is the midpoint.
    if BuildIntraEdges(*edges, plane[:], 16, 0, 0, 64, 64, 15, 15, false, false, false, false, 12).code != DecodeOK ||
        edges.available_width != 16 || edges.available_height != 16 { return 37 }
    big: [4096]u16; many: [4096]u16
    for i: 0..4095 { many[i] = 9 }
    if BuildIntraEdges(*edges, many[:], 64, 0, 0, 64, 64, 63, 63, false, false, false, false, 12).code != DecodeOK { return 38 }
    if PredictIntra(big[:], 64, *edges, 0, 0, 0, true, 0).code != InvalidInput { return 39 }
    if PredictIntra(big[:], 64, *edges, 0, 0, -1, true, 0).code != DecodeOK { return 40 }
    for i: 0..4095 { if big[i] != 2048 { return 41 } }
    return 0
}

// CfL fields: width height subsampling_x subsampling_y luma_width luma_height
// alpha depth seed style hash1 hash2. Luma uses stride 64; chroma starts
// as a per-sample prediction with stride width+1 and a guarded gap column.
RunCflCase :: (c: []s32, luma: []u16, chroma: []u16) -> s32 {
    w := c[0]; h := c[1]; lw := c[4]; lh := c[5]
    depth := cast(s64)c[7]; seed := cast(s64)c[8]; style := cast(s64)c[9]
    for r: 0..cast(s64)lh - 1 { for column: 0..cast(s64)lw - 1 { luma[r * 64 + column] = IntraTestSample(seed, style, depth, r, column) } }
    stride := w + 1
    used := cast(s64)(h - 1) * stride + w
    for i: 0..used - 1 { chroma[i] = 65535 }
    for i: 0..cast(s64)h - 1 { for j: 0..cast(s64)w - 1 { chroma[i * stride + j] = IntraTestSample(seed + 1, style, depth, i, j) } }
    if ApplyCfl(chroma[:used], stride, luma[:cast(s64)(lh - 1) * 64 + lw], 64, w, h, c[2], c[3], lw, lh, c[6], c[7]).code != DecodeOK { return 1 }
    hash1: s64; hash2: s64
    for i: 0..cast(s64)h - 1 {
        for j: 0..cast(s64)w - 1 {
            value := cast(s64)chroma[i * stride + j]
            hash1 = (hash1 * 31 + value + 1) % 2147483647
            hash2 = (hash2 * 1000003 + value * 7 + 3) % 2147483629
        }
        if i < h - 1 && chroma[i * stride + w] != 65535 { return 3 }
    }
    if hash1 != cast(s64)c[10] || hash2 != cast(s64)c[11] { return 4 }
    return 0
}

CflBoundaries :: () -> s32 {
    luma: [64]u16; chroma: [40]u16
    for i: 0..63 { luma[i] = 10 }
    for i: 0..39 { chroma[i] = 100 }
    if ApplyCfl(chroma[:], 4, luma[:], 8, 64, 4, 0, 0, 8, 8, 1, 8).code != InvalidInput { return 1 }
    if ApplyCfl(chroma[:], 4, luma[:], 8, 2, 4, 0, 0, 8, 8, 1, 8).code != InvalidInput { return 2 }
    if ApplyCfl(chroma[:], 4, luma[:], 8, 4, 4, 0, 1, 8, 8, 1, 8).code != InvalidInput { return 3 }
    if ApplyCfl(chroma[:], 4, luma[:], 8, 4, 4, 0, 0, 8, 8, 17, 8).code != InvalidInput { return 4 }
    if ApplyCfl(chroma[:], 4, luma[:], 8, 4, 4, 0, 0, 8, 8, 1, 9).code != InvalidInput { return 5 }
    if ApplyCfl(chroma[:15], 4, luma[:], 8, 4, 4, 0, 0, 8, 8, 1, 8).code != InvalidInput { return 6 }
    if ApplyCfl(chroma[:], 3, luma[:], 8, 4, 4, 0, 0, 8, 8, 1, 8).code != InvalidInput { return 7 }
    if ApplyCfl(chroma[:], 4, luma[:63], 8, 4, 4, 0, 0, 8, 8, 1, 8).code != InvalidInput { return 8 }
    if ApplyCfl(chroma[:], 4, luma[:], 8, 4, 4, 1, 1, 1, 8, 1, 8).code != InvalidInput { return 9 }
    if ApplyCfl(chroma[:], 4, luma[:], 7, 4, 4, 0, 0, 8, 8, 1, 8).code != InvalidInput { return 10 }
    luma[9] = 256
    if ApplyCfl(chroma[:], 4, luma[:], 8, 4, 4, 0, 0, 8, 8, 1, 8).code != InvalidInput { return 11 }
    luma[9] = 10; chroma[15] = 256
    if ApplyCfl(chroma[:], 4, luma[:], 8, 4, 4, 0, 0, 8, 8, 1, 8).code != InvalidInput { return 12 }
    chroma[15] = 100
    token: Cancellation; Cancel(*token)
    if ApplyCfl(chroma[:], 4, luma[:], 8, 4, 4, 0, 0, 8, 8, 16, 8, *token).code != DecodeCancelled { return 13 }
    for i: 0..39 { if chroma[i] != 100 { return 14 } }
    // One bright luma sample: L = 208 there and 80 elsewhere, average 88.
    luma[0] = 26
    if ApplyCfl(chroma[:], 4, luma[:], 8, 4, 4, 0, 0, 8, 8, 16, 8).code != DecodeOK { return 15 }
    if chroma[0] != 130 { return 16 }
    for i: 1..15 { if chroma[i] != 98 { return 17 } }
    for i: 16..39 { if chroma[i] != 100 { return 18 } }
    return 0
}
