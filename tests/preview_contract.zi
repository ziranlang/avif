#import "avif/preview"
#import "std/byte_text_linux"
#import "std/file"
#import "std/text"
#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    pixels: [140]u8
    for y: 0..4 { for x: 0..6 {
        at := (y * 7 + x) * 4
        pixels[at] = cast(u8)((x * 43 + y * 11) % 256)
        pixels[at+1] = cast(u8)((x * 13 + y * 61) % 256)
        pixels[at+2] = cast(u8)((x * 71 + y * 23) % 256)
        pixels[at+3] = cast(u8)((x * 29 + y * 47) % 256)
    } }
    source := RgbaView.{7,5,28,pixels[:]}
    identity: [140]u8
    options := DefaultOptions()
    result := LanczosRGBA8Into(source,7,5,OutputBuffer.{identity[:],28},options)
    if !result.is_ok { return 1 }
    for i: 0..139 { if identity[i] != pixels[i] { return 2 } }
    // Half of the 2x1 source is transparent, so the alpha is exactly 127.5
    // and a last-bit difference in the filter sums rounds it either way.
    edge: [8]u8 = .[255,0,0,0,0,0,255,255]
    filtered: [4]u8
    result = LanczosRGBA8Into(RgbaView.{2,1,8,edge[:]},1,1,OutputBuffer.{filtered[:],4},options)
    if !result.is_ok || filtered[0] != cast(u8)0 || filtered[2] != cast(u8)255 || filtered[3] < cast(u8)127 || filtered[3] > cast(u8)128 { return 3 }
    result = LanczosRGBA8Into(source,7,5,OutputBuffer.{pixels[:],28},options)
    if result.is_ok || result.error.code != InvalidInput || result.output_may_be_modified { return 4 }
    cancellation: Cancellation; cancellation.requested = true; options.cancellation = *cancellation
    result = LanczosRGBA8Into(source,7,5,OutputBuffer.{identity[:],28},options)
    if result.is_ok || result.error.code != DecodeCancelled || result.output_may_be_modified { return 5 }
    options = DefaultOptions(); options.limits.max_working_bytes = 1
    result = LanczosRGBA8Into(source,3,2,OutputBuffer.{identity[:],12},options)
    if result.is_ok || result.error.code != LimitExceeded || result.output_may_be_modified { return 6 }
    options = DefaultOptions(); budget := NewWorkerBudget(options.limits); options.workers = *budget
    dimensions: [4]s32 = .[3,2,11,9]
    for test: 0..1 {
        width := dimensions[test*2]; height := dimensions[test*2+1]
        output: Vec(u8); size := cast(s64)width*height*4
        unused VecResizeBounded(output,size,size)
        result = LanczosRGBA8Into(source,width,height,OutputBuffer.{VecSlice(output,0,size),cast(s64)width*4},options)
        if !result.is_ok || budget.active_workers != 0 || budget.working_bytes != 0 { return 7 }
        if argc == 2 {
            path: Vec(u8); BuilderPrint(*path,"%/preview-%x%.rgba",TextFromCString(argv[1]),width,height)
            if !WriteEntireFile(BuilderFinish(path),TextFromBytes(VecSlice(output,0,size))) { return 8 }
        }
    }
    return 0
}
