#import, file "../src/av1/decoder.zi";

#program_export
AllocationFailure :: () -> s32 {
    data: [14]u8 = .[18,0,10,5,24,8,191,33,80,50,3,16,0,48]
    options := DefaultOptions()
    budget := NewWorkerBudget(options.limits); options.workers = *budget
    result := DecodeAv1YUV(BorrowBytes(data[:]), *options)
    if result.is_ok || result.error.code != AllocationFailed || result.y.storage.count != 0 ||
        budget.active_workers != 0 || budget.working_bytes != 0 { return 1 }
    return 0
}
