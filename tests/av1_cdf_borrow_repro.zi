// Compiler repro only. The caller retains the owner while using either view.
CDFOwnerRepro :: struct { values: [4]u16; }
CDFViewRepro :: struct { values: []u16; }

BorrowCDFDirectRepro :: (owner: *CDFOwnerRepro) -> []u16 {
    return owner.values[:]
}

BorrowCDFWrappedRepro :: (owner: *CDFOwnerRepro) -> CDFViewRepro {
    result: CDFViewRepro
    result.values = owner.values[:]
    return result
}

main :: () -> s32 {
    owner: CDFOwnerRepro
    direct := BorrowCDFDirectRepro(*owner)
    wrapped := BorrowCDFWrappedRepro(*owner)
    direct[0] = 7; wrapped.values[1] = 9
    return ifx owner.values[0] == 7 && owner.values[1] == 9 then 0 else 1
}
