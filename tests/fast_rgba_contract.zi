// The native bridge's fast 8-bit conversion (src/bridge/fast_rgba.zi) against
// the scalar reference (src/color.zi), which matches libavif's centred
// bilinear chroma: every channel within one level, across subsampling,
// matrices, ranges, alpha and odd edges. It also times both.
#import "color"
#import "output"
#import "fast_rgba"
#import "std/vec"
#import "std/timer_linux"

FastCase :: struct { width: s32; height: s32; format: s32; matrix: s32; full: bool; alpha: bool }

FastNext :: (state: *u32) -> u32 {
    state[0] = state[0] * cast(u32)1664525 + cast(u32)1013904223
    return state[0] >> 24
}

// Smooth gradients with noise, so both flat runs and sharp edges occur.
FastFill :: (plane: []u8, width: s32, height: s32, seed: u32) {
    state := seed
    for y: cast(s32)0..height-1 {
        for x: cast(s32)0..width-1 {
            ramp := (cast(u32)(x * 7 + y * 3) + seed) & cast(u32)255
            noise := FastNext(*state) & cast(u32)63
            value := ifx (FastNext(*state) & cast(u32)15) == 0 then FastNext(*state) else (ramp + noise) & cast(u32)255
            plane[cast(s64)y * width + x] = cast(u8)value
        }
    }
}

FastCheck :: (case: FastCase, index: s64, timed: bool) -> s32 {
    sx: s32 = ifx case.format == 1 then 0 else 1
    sy: s32 = ifx case.format == 3 then 1 else 0
    w := case.width; h := case.height
    cw := (w + sx) >> sx; ch := (h + sy) >> sy
    y: Vec(u8); u: Vec(u8); v: Vec(u8); a: Vec(u8); expected: Vec(u8); actual: Vec(u8)
    defer { VecFree(y); VecFree(u); VecFree(v); VecFree(a); VecFree(expected); VecFree(actual) }
    if !VecResize(y, cast(s64)w * h) || !VecResize(u, cast(s64)cw * ch) || !VecResize(v, cast(s64)cw * ch) ||
        !VecResize(a, cast(s64)w * h) || !VecResize(expected, cast(s64)w * h * 4) || !VecResize(actual, cast(s64)w * h * 4) {
        print("fast rgba case %: allocation failed\n", index); return 1
    }
    FastFill(y[:], w, h, cast(u32)(index * 31 + 1))
    FastFill(u[:], cw, ch, cast(u32)(index * 31 + 7))
    FastFill(v[:], cw, ch, cast(u32)(index * 31 + 13))
    FastFill(a[:], w, h, cast(u32)(index * 31 + 19))
    source: PlanarImage
    source.color = ColorSpec.{8, case.full, case.matrix, sx, sy, false, BilinearChroma, 1}
    source.y = PlaneView.{w, h, cast(s64)w, 1, y[:]}
    source.u = PlaneView.{cw, ch, cast(s64)cw, 1, u[:]}
    source.v = PlaneView.{cw, ch, cast(s64)cw, 1, v[:]}
    source.alpha = PlaneView.{w, h, cast(s64)w, 1, a[:]}
    source.has_alpha = case.alpha
    options := DefaultOptions(); budget := NewWorkerBudget(options.limits); options.workers = *budget
    started := MonotonicNanoseconds()
    reference := ConvertRGBA8Into(source, OutputBuffer.{expected[:], cast(s64)w * 4}, options)
    reference_ns := MonotonicNanoseconds() - started
    if !reference.is_ok { print("fast rgba case %: reference error %\n", index, reference.error.code); return 1 }
    alpha: *u8 = ifx case.alpha then *a[0] else cast(*u8)null
    started = MonotonicNanoseconds()
    ok := FastRGBA8(*y[0], cast(s64)w, *u[0], cast(s64)cw, *v[0], cast(s64)cw, alpha, cast(s64)w,
        w, h, case.format, case.matrix, case.full, *actual[0], cast(s64)w * 4)
    fast_ns := MonotonicNanoseconds() - started
    if !ok { print("fast rgba case %: not converted\n", index); return 1 }
    worst: s32 = 0; off: s64 = 0
    for at: cast(s64)0..expected.count-1 {
        difference := cast(s32)expected[at] - cast(s32)actual[at]
        if difference < 0 { difference = -difference }
        if difference > worst { worst = difference }
        if difference > 0 { off += 1 }
    }
    if worst > 1 {
        print("fast rgba case % (%x% format % matrix % full %): channel off by %\n", index, w, h, case.format, case.matrix, case.full, worst)
        return 1
    }
    if timed {
        print("fast rgba %x% format %: reference % ms, fast % ms, % of % channels one level off\n", w, h, case.format,
            reference_ns / 1000000, fast_ns / 1000000, off, expected.count)
    }
    return 0
}

#program_export
main :: () -> s32 {
    cases: [12]FastCase = .[
        .{7, 5, 3, 6, true, false}, .{8, 6, 3, 1, true, true}, .{9, 7, 3, 9, false, false},
        .{1, 1, 3, 6, true, false}, .{2, 3, 3, 5, false, true}, .{33, 17, 3, 1, false, false},
        .{7, 5, 2, 6, true, true}, .{10, 3, 2, 1, false, false},
        .{7, 5, 1, 6, true, false}, .{6, 4, 1, 9, false, true},
        .{640, 360, 3, 6, true, false}, .{640, 360, 1, 6, true, true},
    ]
    failures: s32 = 0
    for case, index: cases { failures += FastCheck(case, cast(s64)index, case.width >= 640) }
    print("fast rgba: % cases, % failures\n", cases.count, failures)
    return failures
}
