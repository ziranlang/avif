#import, file "../src/av1/prediction.zi";

PredictionBoundaries :: () -> s32 {
    above: [4]u16; left: [4]u16
    if PredictIntra4x4(above[:3], left[:], 0, true, true, 0, 8).error.code != InvalidInput { return 1 }
    if PredictIntra4x4(above[:], left[:3], 0, true, true, 0, 8).error.code != InvalidInput { return 2 }
    if PredictIntra4x4(above[:], left[:], 0, true, true, 0, 16).error.code != InvalidInput { return 3 }
    if PredictIntra4x4(above[:], left[:], 256, true, true, 0, 8).error.code != InvalidInput { return 4 }
    above[3] = 256
    invalid := PredictIntra4x4(above[:], left[:], 0, true, true, 0, 8)
    if invalid.error.code != InvalidInput { return 5 }
    for i: 0..15 { if invalid.samples[i] != 0 { return 6 } }
    above[3] = 0; left[3] = 65535
    if PredictIntra4x4(above[:], left[:], 0, true, true, 0, 12).error.code != InvalidInput { return 7 }
    left[3] = 0
    if PredictIntra4x4(above[:], left[:], 0, true, true, 3, 8).error.code != UnsupportedCapability { return 8 }
    token: Cancellation; Cancel(*token)
    cancelled := PredictIntra4x4(above[:], left[:], 0, true, true, 0, 8, *token)
    if cancelled.error.code != DecodeCancelled { return 9 }
    for i: 0..15 { if cancelled.samples[i] != 0 { return 10 } }
    return 0
}
